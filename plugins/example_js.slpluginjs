{
  "_doc": [
    "SpectraLab JS Plugin (.slpluginjs)",
    "",
    "This is a programmable plugin for complex formats that need custom",
    "logic to extract or patch picture data. The code runs in the browser",
    "via new Function(), so standard JS is available but no DOM access.",
    "",
    "Extra fields (compared to .slplugin):",
    "  type       Must be 'js'",
    "  jsSource   JavaScript source code — either a single string,",
    "             or an array of strings (one per line, joined with '\\n').",
    "             Using an array is strongly recommended for readability.",
    "",
    "JS API — your code must assign to 'plugin':",
    "",
    "  plugin = {",
    "    extract(fileBytes, snapshot) {",
    "      // fileBytes  — Uint8Array of the entire file",
    "      // snapshot   — parsed snapshot object or null:",
    "      //   { banks: Uint8Array[8], machineType, pagingByte }",
    "      //   banks[] are subarray views into fileBytes (zero-copy)",
    "      //",
    "      // Return: array of { name, format, data }",
    "      //   name   — display name (string)",
    "      //   format — SpectraLab format: 'scr', 'ifl', 'mlt', etc.",
    "      //   data   — Uint8Array of raw picture bytes",
    "    },",
    "",
    "    patch(originalBytes, pictures, snapshot) {",
    "      // originalBytes — Uint8Array, deep copy of the original file",
    "      // pictures      — array of { name, format, data } with current edits",
    "      // snapshot      — same as above, banks point into originalBytes",
    "      //",
    "      // Write modified data back. For .sna files, writing into",
    "      // snapshot.banks[] automatically modifies originalBytes.",
    "      // Return: Uint8Array (the patched file to download)",
    "      //",
    "      // Optional — omit if save-back is not needed.",
    "    }",
    "  };",
    "",
    "Tips:",
    "  - snapshot.banks[5] is always the main 16K at 0x4000-0x7FFF",
    "  - snapshot.banks[2] is always the 16K at 0x8000-0xBFFF",
    "  - The screen bitmap+attrs occupy the first 6912 bytes of bank 5",
    "  - For non-snapshot files, snapshot is null — use fileBytes directly"
  ],

  "id": "custom_offset_extractor",
  "name": "Custom Offset Extractor (JS example)",
  "version": 1,
  "description": "Example JS plugin — extracts the main screen from a snapshot, or first 6912 bytes from any binary",
  "fileExtensions": [".sna", ".z80", ".bin"],
  "type": "js",

  "jsSource": [
    "plugin = {",
    "",
    "  // ---------------------------------------------------------------",
    "  // extract() — read picture data from the file",
    "  // ---------------------------------------------------------------",
    "  extract: function(fileBytes, snapshot) {",
    "    var pics = [];",
    "",
    "    if (snapshot && snapshot.banks && snapshot.banks[5]) {",
    "      // Snapshot file: grab the main screen from bank 5",
    "      // (first 6912 bytes = 6144 bitmap + 768 attributes)",
    "      pics.push({",
    "        name:   'Main Screen',",
    "        format: 'scr',",
    "        data:   snapshot.banks[5].subarray(0, 6912)",
    "      });",
    "    } else if (fileBytes.length >= 6912) {",
    "      // Raw binary: just take the first 6912 bytes as SCR",
    "      pics.push({",
    "        name:   'First 6912 bytes',",
    "        format: 'scr',",
    "        data:   fileBytes.slice(0, 6912)",
    "      });",
    "    }",
    "",
    "    return pics;",
    "  },",
    "",
    "  // ---------------------------------------------------------------",
    "  // patch() — write edited pictures back into the file",
    "  // ---------------------------------------------------------------",
    "  patch: function(originalBytes, pictures, snapshot) {",
    "    if (snapshot && snapshot.banks && snapshot.banks[5]",
    "        && pictures.length > 0",
    "        && pictures[0].data.length >= 6912) {",
    "      // Write edited screen data back into bank 5.",
    "      // Because banks[5] is a subarray view into originalBytes,",
    "      // this set() call modifies the file buffer directly —",
    "      // no extra copying needed.",
    "      snapshot.banks[5].set(",
    "        pictures[0].data.subarray(0, 6912),",
    "        0",
    "      );",
    "    }",
    "    return originalBytes;",
    "  }",
    "",
    "};"
  ]
}
