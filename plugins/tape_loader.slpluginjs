{
  "_doc": [
    "SpectraLab Tape Loader Plugin",
    "",
    "Exports the current SCR screen with byte reordering for visual tape",
    "loading effects. The user selects a loading scheme and download format",
    "(raw .scr or .zip archive with .scr + sjasmplus .asm source).",
    "",
    "Schemes:",
    "  1 = Backward (5AFF->4000) - custom tape loader stores bytes from",
    "      $5AFF down to $4000 in real-time. Attrs appear first, then bitmap.",
    "  2 = Linear (top->bottom)  - 8 bitmap lines then 32 attr bytes per",
    "      character row, top to bottom. Colors appear row by row.",
    "  3 = Checkerboard 2x2 - 16x12 char blocks in checkerboard pattern.",
    "  4 = Checkerboard 4x3 - 8x8 char blocks in checkerboard pattern.",
    "  5 = Checkerboard 8x6 - 4x4 char blocks in checkerboard pattern.",
    "  6 = Turbo Linear    - TZX with custom turbo loader (~2x speed).",
    "      Uses edge-detection MC in REM line + TZX block $11 turbo data.",
    "",
    "Schemes 1-5: .asm source with SAVETAP directives for sjasmplus (.tap).",
    "Scheme 6: TZX built directly by the plugin (block $10 + block $11)."
  ],

  "id": "tape_loader",
  "name": "Tape Loader Schemes",
  "version": 1,
  "description": "Export screen with different byte orderings for visual tape loading effects",
  "fileExtensions": [".scr"],
  "type": "js",

  "jsSource": [
    "// ===================================================================",
    "// Tape Loader Schemes plugin",
    "// ===================================================================",
    "",
    "// -------------------------------------------------------------------",
    "// CRC32 + ZIP utilities (store method, no compression)",
    "// -------------------------------------------------------------------",
    "var crc32Table = null;",
    "",
    "function crc32(data) {",
    "  if (!crc32Table) {",
    "    crc32Table = new Uint32Array(256);",
    "    for (var i = 0; i < 256; i++) {",
    "      var c = i;",
    "      for (var j = 0; j < 8; j++) {",
    "        c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);",
    "      }",
    "      crc32Table[i] = c;",
    "    }",
    "  }",
    "  var crc = 0xFFFFFFFF;",
    "  for (var i = 0; i < data.length; i++) {",
    "    crc = crc32Table[(crc ^ data[i]) & 0xFF] ^ (crc >>> 8);",
    "  }",
    "  return (crc ^ 0xFFFFFFFF) >>> 0;",
    "}",
    "",
    "function createZip(files) {",
    "  var localHeaders = [];",
    "  var centralHeaders = [];",
    "  var offset = 0;",
    "",
    "  for (var f = 0; f < files.length; f++) {",
    "    var nameBytes = new TextEncoder().encode(files[f].name);",
    "    var data = files[f].data;",
    "    var crc = crc32(data);",
    "",
    "    var localHeader = new Uint8Array(30 + nameBytes.length);",
    "    var lv = new DataView(localHeader.buffer);",
    "    lv.setUint32(0, 0x04034b50, true);",
    "    lv.setUint16(4, 20, true);",
    "    lv.setUint16(6, 0, true);",
    "    lv.setUint16(8, 0, true);",
    "    lv.setUint16(10, 0, true);",
    "    lv.setUint16(12, 0, true);",
    "    lv.setUint32(14, crc, true);",
    "    lv.setUint32(18, data.length, true);",
    "    lv.setUint32(22, data.length, true);",
    "    lv.setUint16(26, nameBytes.length, true);",
    "    lv.setUint16(28, 0, true);",
    "    localHeader.set(nameBytes, 30);",
    "",
    "    var centralHeader = new Uint8Array(46 + nameBytes.length);",
    "    var cv = new DataView(centralHeader.buffer);",
    "    cv.setUint32(0, 0x02014b50, true);",
    "    cv.setUint16(4, 20, true);",
    "    cv.setUint16(6, 20, true);",
    "    cv.setUint16(8, 0, true);",
    "    cv.setUint16(10, 0, true);",
    "    cv.setUint16(12, 0, true);",
    "    cv.setUint16(14, 0, true);",
    "    cv.setUint32(16, crc, true);",
    "    cv.setUint32(20, data.length, true);",
    "    cv.setUint32(24, data.length, true);",
    "    cv.setUint16(28, nameBytes.length, true);",
    "    cv.setUint16(30, 0, true);",
    "    cv.setUint16(32, 0, true);",
    "    cv.setUint16(34, 0, true);",
    "    cv.setUint16(36, 0, true);",
    "    cv.setUint32(38, 0, true);",
    "    cv.setUint32(42, offset, true);",
    "    centralHeader.set(nameBytes, 46);",
    "",
    "    localHeaders.push({ header: localHeader, data: data });",
    "    centralHeaders.push(centralHeader);",
    "    offset += localHeader.length + data.length;",
    "  }",
    "",
    "  var centralDirOffset = offset;",
    "  var centralDirSize = 0;",
    "  for (var i = 0; i < centralHeaders.length; i++) {",
    "    centralDirSize += centralHeaders[i].length;",
    "  }",
    "",
    "  var endRecord = new Uint8Array(22);",
    "  var ev = new DataView(endRecord.buffer);",
    "  ev.setUint32(0, 0x06054b50, true);",
    "  ev.setUint16(4, 0, true);",
    "  ev.setUint16(6, 0, true);",
    "  ev.setUint16(8, files.length, true);",
    "  ev.setUint16(10, files.length, true);",
    "  ev.setUint32(12, centralDirSize, true);",
    "  ev.setUint32(16, centralDirOffset, true);",
    "  ev.setUint16(20, 0, true);",
    "",
    "  var totalSize = offset + centralDirSize + 22;",
    "  var result = new Uint8Array(totalSize);",
    "  var pos = 0;",
    "  for (var i = 0; i < localHeaders.length; i++) {",
    "    result.set(localHeaders[i].header, pos);",
    "    pos += localHeaders[i].header.length;",
    "    result.set(localHeaders[i].data, pos);",
    "    pos += localHeaders[i].data.length;",
    "  }",
    "  for (var i = 0; i < centralHeaders.length; i++) {",
    "    result.set(centralHeaders[i], pos);",
    "    pos += centralHeaders[i].length;",
    "  }",
    "  result.set(endRecord, pos);",
    "  return result;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Scheme 1: Backward (reverse all 6912 bytes)",
    "// -------------------------------------------------------------------",
    "function reverseScreen(data) {",
    "  var result = new Uint8Array(6912);",
    "  for (var i = 0; i < 6912; i++) {",
    "    result[i] = data[6911 - i];",
    "  }",
    "  return result;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// ASM generator for Backward scheme",
    "// -------------------------------------------------------------------",
    "function generateBackwardLoaderInc() {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; backward_loader.inc',",
    "    '; Backward tape loader (5AFF->4000) for ZX Spectrum',",
    "    '; ==========================================================',",
    "    ';',",
    "    '; Uses ROM routines for pilot/sync/byte reading:',",
    "    ';   $0562 - LD-BYTES from IN A,($FE): pilot + sync + flag',",
    "    ';   $05C6 - LD-DEC: reads one byte into L (with DE=0 trick)',",
    "    '; The timing-critical edge detection runs from ROM (non-',",
    "    '; contended), so no memory relocation is needed.',",
    "    ';',",
    "    '; Usage:',",
    "    ';   Place inside a REM line so it starts at $5CD0 (23760).',",
    "    ';   Call with RANDOMIZE USR 23760.',",
    "    ';   The tape block must be HEADLESS with flag $FE.',",
    "    ';   The .scr data must be reversed (byte 6911 first).',",
    "    ';',",
    "    '; Labels provided:',",
    "    ';   loader_entry - entry point (must be at $5CD0)',",
    "    ';   loader_end   - end marker (for line length calculation)',",
    "    '; ==========================================================',",
    "    '',",
    "    'loader_entry:                      ; = $5CD0 (23760)',",
    "    '  di',",
    "    '',",
    "    '  ; --- Call ROM $0562 for pilot + sync + flag byte ---',",
    "    '  ; ROM $0562 is LD-BYTES entry after DI/border setup.',",
    "    '  ; It reads: pilot tone, sync pulse, flag byte, then',",
    "    '  ; with DE=0 returns immediately after the flag byte.',",
    "    '  ; The flag byte is returned in L register.',",
    "    '  ; NOTE: ROM stores the flag byte at (IX+0), so IX must',",
    "    '  ; point to a safe (writable, non-critical) address.',",
    "    '  ld ix, $4000                    ; safe target for ROM flag store',",
    "    '  ld de, 0                        ; DE=0: return after flag byte',",
    "    '  xor a',",
    "    '  out ($FE), a                    ; black border',",
    "    '  call $0562                      ; ROM: pilot + sync + flag',",
    "    '',",
    "    '  ; --- Verify flag byte ---',",
    "    '  ld a, $FE                       ; our custom flag marker',",
    "    '  xor l                           ; compare with loaded flag',",
    "    '  jr nz, loader_entry             ; wrong flag, retry',",
    "    '',",
    "    '  ; --- Load 6912 bytes backward using ROM LD-DEC ($05C6) ---',",
    "    '  ; ROM $05C6 reads one byte into L (parity in H).',",
    "    '  ; We call it with DE=0 so it returns after each byte.',",
    "    '  ld ix, $5AFF                    ; start at top of screen',",
    "    '  exx',",
    "    '  ld de, 6912                     ; byte count (shadow DE)',",
    "    '  exx',",
    "    '',",
    "    'ld_data_loop:',",
    "    '  call $05C6                      ; ROM: read one byte into L',",
    "    '  ld (ix+0), l                    ; store byte',",
    "    '  dec ix                          ; BACKWARD!',",
    "    '  exx',",
    "    '  dec de                          ; decrement shadow counter',",
    "    '  ld a, d',",
    "    '  or e',",
    "    '  exx',",
    "    '  jr nz, ld_data_loop',",
    "    '',",
    "    '  ; --- Read checksum byte (ignore result) ---',",
    "    '  call $05C6',",
    "    '',",
    "    '  ei',",
    "    '  ret',",
    "    '',",
    "    'loader_end:',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "function generateBackwardAsm(baseName) {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; Tape Loader: Backward scheme (5AFF->4000)',",
    "    '; ==========================================================',",
    "    '; The .scr on tape is reversed so each byte lands at its',",
    "    '; correct address. Visual effect: attrs appear first',",
    "    '; (bottom to top), then bitmap fills from bottom up.',",
    "    ';',",
    "    '; The .tap contains two blocks:',",
    "    ';   1. BASIC program (REM with loader MC)',",
    "    ';   2. HEADLESS data: reversed screen (6912 bytes, flag $FE)',",
    "    ';',",
    "    '; Build with sjasmplus:',",
    "    ';   sjasmplus ' + baseName + '.asm',",
    "    ';',",
    "    '; Produces ' + baseName + '.tap',",
    "    '; ==========================================================',",
    "    '',",
    "    '  DEVICE ZXSPECTRUM48',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; Reversed screen data at $4000 (6912 bytes)',",
    "    '; ----------------------------------------------------------',",
    "    '  ORG $4000',",
    "    '',",
    "    'screen_data:',",
    "    '  INCBIN \"' + baseName + '.scr\"',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; BASIC program at PROG ($5CCB)',",
    "    ';',",
    "    '; Line 1: REM + loader MC',",
    "    '; Line 10: RANDOMIZE USR 23760: PAUSE 0',",
    "    ';',",
    "    '; USR 23760 runs the loader at $5CD0 which uses ROM routines',",
    "    '; for tape I/O (timing-critical code runs from ROM).',",
    "    '; ----------------------------------------------------------',",
    "    '  ORG $5CCB',",
    "    '',",
    "    'basic_start:',",
    "    '',",
    "    '  ; === Line 1: REM + machine code ===',",
    "    '  db $00, $01                     ; line number 1',",
    "    '  db line1_end - line1_start, $00 ; line length',",
    "    'line1_start:',",
    "    '  db $EA                          ; REM token',",
    "    '',",
    "    '  INCLUDE \"backward_loader.inc\"',",
    "    '',",
    "    '  db $0D                          ; ENTER (end of line 1)',",
    "    'line1_end:',",
    "    '',",
    "    '  ; === Line 10: RANDOMIZE USR 23760: PAUSE 0 ===',",
    "    '  db $00, $0A                     ; line number 10',",
    "    '  db line10_end - line10_start, $00 ; line length',",
    "    'line10_start:',",
    "    '  db $F9                          ; RANDOMIZE token',",
    "    '  db $C0                          ; USR token',",
    "    '  db \"23760\"',",
    "    '  db $0E, $00, $00, $D0, $5C, $00 ; 5-byte FP: 23760',",
    "    '  db \":\"',",
    "    '  db $F2                          ; PAUSE token',",
    "    '  db \"0\"',",
    "    '  db $0E, $00, $00, $00, $00, $00 ; 5-byte FP: 0',",
    "    '  db $0D                          ; ENTER',",
    "    'line10_end:',",
    "    '',",
    "    'basic_end:',",
    "    '  db $80                          ; end-of-variables marker',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; SAVETAP directives',",
    "    '; ----------------------------------------------------------',",
    "    '  SAVETAP \"' + baseName + '.tap\", BASIC, \"' + baseName.substring(0, 10) + '\", basic_start, basic_end + 1 - basic_start, 10',",
    "    '  SAVETAP \"' + baseName + '.tap\", HEADLESS, $4000, 6912, $FE',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Scheme 2: Linear (top-to-bottom, attrs after each 8 bitmap lines)",
    "// -------------------------------------------------------------------",
    "function linearScreen(data) {",
    "  var result = new Uint8Array(6912);",
    "  var pos = 0;",
    "  for (var r = 0; r < 24; r++) {",
    "    var third = (r >> 3);",
    "    var rit = r & 7;",
    "    for (var p = 0; p < 8; p++) {",
    "      var srcOff = third * 2048 + p * 256 + rit * 32;",
    "      for (var c = 0; c < 32; c++) result[pos++] = data[srcOff + c];",
    "    }",
    "    var attrOff = 6144 + r * 32;",
    "    for (var c = 0; c < 32; c++) result[pos++] = data[attrOff + c];",
    "  }",
    "  return result;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Scheme 3/4/5: Checkerboard (even blocks first, then odd blocks)",
    "// -------------------------------------------------------------------",
    "function checkerboardScreen(data, blockW, blockH) {",
    "  var result = new Uint8Array(6912);",
    "  var pos = 0;",
    "  var gridCols = 32 / blockW;",
    "  var gridRows = 24 / blockH;",
    "  for (var pass = 0; pass < 2; pass++) {",
    "    for (var gy = 0; gy < gridRows; gy++) {",
    "      for (var gx = 0; gx < gridCols; gx++) {",
    "        if ((gx + gy) % 2 !== pass) continue;",
    "        var startCol = gx * blockW;",
    "        var startRow = gy * blockH;",
    "        for (var cr = 0; cr < blockH; cr++) {",
    "          var r = startRow + cr;",
    "          var third = (r >> 3);",
    "          var rit = r & 7;",
    "          for (var p = 0; p < 8; p++) {",
    "            var srcOff = third * 2048 + p * 256 + rit * 32 + startCol;",
    "            for (var c = 0; c < blockW; c++) result[pos++] = data[srcOff + c];",
    "          }",
    "        }",
    "        for (var cr = 0; cr < blockH; cr++) {",
    "          var r = startRow + cr;",
    "          var attrOff = 6144 + r * 32 + startCol;",
    "          for (var c = 0; c < blockW; c++) result[pos++] = data[attrOff + c];",
    "        }",
    "      }",
    "    }",
    "  }",
    "  return result;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// ASM generator for Checkerboard loader .inc",
    "// -------------------------------------------------------------------",
    "function generateCheckerboardBlockTable(blockW, blockH) {",
    "  var gridCols = 32 / blockW;",
    "  var gridRows = 24 / blockH;",
    "  var table = [];",
    "  for (var pass = 0; pass < 2; pass++) {",
    "    for (var gy = 0; gy < gridRows; gy++) {",
    "      for (var gx = 0; gx < gridCols; gx++) {",
    "        if ((gx + gy) % 2 !== pass) continue;",
    "        table.push({ col: gx * blockW, row: gy * blockH });",
    "      }",
    "    }",
    "  }",
    "  return table;",
    "}",
    "",
    "function generateCheckerboardLoaderInc(blockW, blockH, schemeName) {",
    "  var table = generateCheckerboardBlockTable(blockW, blockH);",
    "  var totalBlocks = table.length;",
    "  var bitmapPerBlock = blockH * 8 * blockW;",
    "  var attrPerBlock = blockH * blockW;",
    "  var lines = [];",
    "  lines.push('; ==========================================================');",
    "  lines.push('; ' + schemeName + '_loader.inc');",
    "  lines.push('; Checkerboard tape loader (' + blockW + 'x' + blockH + ' char blocks)');",
    "  lines.push('; ==========================================================');",
    "  lines.push(';');",
    "  lines.push('; Loads screen in checkerboard pattern: even-positioned blocks');",
    "  lines.push('; first, then odd-positioned blocks. Each block is ' + blockW + ' cols x');",
    "  lines.push('; ' + blockH + ' rows of character cells (' + totalBlocks + ' blocks total).');",
    "  lines.push(';');",
    "  lines.push('; Uses ROM routines:');",
    "  lines.push(';   $0562 - pilot + sync + flag byte');",
    "  lines.push(';   $05C6 - reads one byte into L (DE must be 0)');",
    "  lines.push(';');",
    "  lines.push('; Register plan:');",
    "  lines.push(';   IX  = destination for ld (ix+0), l writes');",
    "  lines.push(';   DE  = 0 (ROM $05C6 requirement)');",
    "  lines.push(\";   HL' = block table pointer\");",
    "  lines.push(\";   C'  = block counter\");",
    "  lines.push(\";   B'  = inner byte counter\");",
    "  lines.push(\";   D'  = current char row within block\");",
    "  lines.push(\";   E'  = block start column\");",
    "  lines.push('; ==========================================================');",
    "  lines.push('');",
    "  lines.push('loader_entry:                      ; = $5CD0 (23760)');",
    "  lines.push('  di');",
    "  lines.push('');",
    "  lines.push('  ; --- Save all registers for BASIC ---');",
    "  lines.push('  push af');",
    "  lines.push('  push bc');",
    "  lines.push('  push de');",
    "  lines.push('  push hl');",
    "  lines.push('  push ix');",
    "  lines.push('  push iy');",
    "  lines.push('  ex af, af\\'');",
    "  lines.push('  exx');",
    "  lines.push('  push af');",
    "  lines.push('  push bc');",
    "  lines.push('  push de');",
    "  lines.push('  push hl');",
    "  lines.push('  exx');",
    "  lines.push('  ex af, af\\'');",
    "  lines.push('');",
    "  lines.push('loader_retry:');",
    "  lines.push('  ; --- Call ROM $0562 for pilot + sync + flag byte ---');",
    "  lines.push('  ld ix, $4000                    ; safe target for ROM flag store');",
    "  lines.push('  ld de, 0                        ; DE=0: return after flag byte');",
    "  lines.push('  xor a');",
    "  lines.push('  out ($FE), a                    ; black border');",
    "  lines.push('  call $0562                      ; ROM: pilot + sync + flag');",
    "  lines.push('');",
    "  lines.push('  ; --- Verify flag byte ---');",
    "  lines.push('  ld a, $FE                       ; our custom flag marker');",
    "  lines.push('  xor l                           ; compare with loaded flag');",
    "  lines.push('  jr nz, loader_retry             ; wrong flag, retry');",
    "  lines.push('');",
    "  lines.push('  ; --- Init block loop ---');",
    "  lines.push('  exx');",
    "  lines.push('  ld hl, block_table              ; HL\\' = table pointer');",
    "  lines.push('  ld c, ' + totalBlocks + '                        ; C\\' = block count');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('ld_block_loop:');",
    "  lines.push('  ; Read (col, row) from table');",
    "  lines.push('  exx');",
    "  lines.push('  ld e, (hl)                      ; E\\' = block start column');",
    "  lines.push('  inc hl');",
    "  lines.push('  ld d, (hl)                      ; D\\' = block start row');",
    "  lines.push('  inc hl');",
    "  lines.push('  push hl                         ; save table pointer');",
    "  lines.push('  push bc                         ; save block counter in C\\'');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('  ; === Bitmap phase: ' + blockH + ' char rows x 8 pixel lines x ' + blockW + ' bytes ===');",
    "  lines.push('  exx');",
    "  lines.push('  ld b, ' + blockH + '                         ; B\\' = char rows in block');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('ld_bmp_crow:');",
    "  lines.push('  ; Compute bitmap address for pixel line 0 of char row D\\'');",
    "  lines.push('  ; High byte = $40 + (row & $18), low byte = (row & 7) * 32 + col');",
    "  lines.push('  exx');",
    "  lines.push('  push de                         ; save D\\'=row, E\\'=col');",
    "  lines.push('  push bc                         ; save B\\'=crow counter');",
    "  lines.push('  ld a, d');",
    "  lines.push('  and $18');",
    "  lines.push('  add a, $40');",
    "  lines.push('  ld h, a');",
    "  lines.push('  ld a, d');",
    "  lines.push('  and $07');",
    "  lines.push('  rrca');",
    "  lines.push('  rrca');",
    "  lines.push('  rrca                            ; (row%8) * 32');",
    "  lines.push('  add a, e                        ; + start column');",
    "  lines.push('  ld l, a');",
    "  lines.push('  ld b, 8                         ; 8 pixel lines');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('ld_bmp_pline:');",
    "  lines.push('  exx');",
    "  lines.push('  push hl                         ; save pixel line address');",
    "  lines.push('  push bc                         ; save B\\'=pline counter');",
    "  lines.push('  push hl');",
    "  lines.push('  exx');",
    "  lines.push('  pop ix                          ; IX = pixel line address');",
    "  lines.push('  exx');",
    "  lines.push('  ld b, ' + blockW + '                        ; B\\' = bytes per line');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('ld_bmp_byte:');",
    "  lines.push('  call $05C6                      ; ROM: read byte into L');",
    "  lines.push('  ld (ix+0), l');",
    "  lines.push('  inc ix');",
    "  lines.push('  exx');",
    "  lines.push('  dec b');",
    "  lines.push('  exx');",
    "  lines.push('  jr nz, ld_bmp_byte');",
    "  lines.push('');",
    "  lines.push('  exx');",
    "  lines.push('  pop bc                          ; restore B\\'=pline counter');",
    "  lines.push('  pop hl                          ; restore pixel line address');",
    "  lines.push('  inc h                           ; next pixel line (+$100)');",
    "  lines.push('  dec b');",
    "  lines.push('  exx');",
    "  lines.push('  jr nz, ld_bmp_pline');",
    "  lines.push('');",
    "  lines.push('  exx');",
    "  lines.push('  pop bc                          ; restore B\\'=crow counter');",
    "  lines.push('  pop de                          ; restore D\\'=row, E\\'=col');",
    "  lines.push('  inc d                           ; next char row');",
    "  lines.push('  dec b');",
    "  lines.push('  exx');",
    "  lines.push('  jr nz, ld_bmp_crow');",
    "  lines.push('');",
    "  lines.push('  ; === Attr phase: ' + blockH + ' char rows x ' + blockW + ' bytes ===');",
    "  lines.push('  ; Re-read original (col, row) from block table');",
    "  lines.push('  exx');",
    "  lines.push('  pop bc                          ; restore block counter');",
    "  lines.push('  pop hl                          ; restore table pointer');",
    "  lines.push('  push hl                         ; re-save table pointer');",
    "  lines.push('  push bc                         ; re-save block counter');",
    "  lines.push('  dec hl');",
    "  lines.push('  ld d, (hl)                      ; D\\' = row (2nd byte of pair)');",
    "  lines.push('  dec hl');",
    "  lines.push('  ld e, (hl)                      ; E\\' = col (1st byte of pair)');",
    "  lines.push('  ld b, ' + blockH + '                         ; B\\' = char rows for attrs');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('ld_attr_crow:');",
    "  lines.push('  ; Attr address = $5800 + row * 32 + col');",
    "  lines.push('  exx');",
    "  lines.push('  push de                         ; save D\\'=row, E\\'=col');",
    "  lines.push('  push bc                         ; save B\\'=crow counter');",
    "  lines.push('  ld a, d');",
    "  lines.push('  and $18');",
    "  lines.push('  rrca');",
    "  lines.push('  rrca');",
    "  lines.push('  rrca                            ; (row & $18) >> 3 = third');",
    "  lines.push('  add a, $58');",
    "  lines.push('  ld h, a');",
    "  lines.push('  ld a, d');",
    "  lines.push('  and $07');",
    "  lines.push('  rrca');",
    "  lines.push('  rrca');",
    "  lines.push('  rrca                            ; (row % 8) * 32');",
    "  lines.push('  add a, e                        ; + start column');",
    "  lines.push('  ld l, a');",
    "  lines.push('  push hl');",
    "  lines.push('  exx');",
    "  lines.push('  pop ix                          ; IX = attr address');",
    "  lines.push('  exx');",
    "  lines.push('  ld b, ' + blockW + '                        ; B\\' = bytes per attr row');",
    "  lines.push('  exx');",
    "  lines.push('');",
    "  lines.push('ld_attr_byte:');",
    "  lines.push('  call $05C6                      ; ROM: read byte into L');",
    "  lines.push('  ld (ix+0), l');",
    "  lines.push('  inc ix');",
    "  lines.push('  exx');",
    "  lines.push('  dec b');",
    "  lines.push('  exx');",
    "  lines.push('  jr nz, ld_attr_byte');",
    "  lines.push('');",
    "  lines.push('  exx');",
    "  lines.push('  pop bc                          ; restore B\\'=crow counter');",
    "  lines.push('  pop de                          ; restore D\\'=row, E\\'=col');",
    "  lines.push('  inc d                           ; next char row');",
    "  lines.push('  dec b');",
    "  lines.push('  exx');",
    "  lines.push('  jr nz, ld_attr_crow');",
    "  lines.push('');",
    "  lines.push('  ; --- Next block ---');",
    "  lines.push('  exx');",
    "  lines.push('  pop bc                          ; restore block counter in C\\'');",
    "  lines.push('  pop hl                          ; restore table pointer');",
    "  lines.push('  dec c');",
    "  lines.push('  exx');",
    "  lines.push('  jp nz, ld_block_loop');",
    "  lines.push('');",
    "  lines.push('  ; --- Read checksum byte ---');",
    "  lines.push('  ld ix, $4000');",
    "  lines.push('  call $05C6');",
    "  lines.push('');",
    "  lines.push('  ; --- Restore all registers for BASIC ---');",
    "  lines.push('  ex af, af\\'');",
    "  lines.push('  exx');",
    "  lines.push('  pop hl');",
    "  lines.push('  pop de');",
    "  lines.push('  pop bc');",
    "  lines.push('  pop af');",
    "  lines.push('  exx');",
    "  lines.push('  ex af, af\\'');",
    "  lines.push('  pop iy');",
    "  lines.push('  pop ix');",
    "  lines.push('  pop hl');",
    "  lines.push('  pop de');",
    "  lines.push('  pop bc');",
    "  lines.push('  pop af');",
    "  lines.push('');",
    "  lines.push('  ei');",
    "  lines.push('  ret');",
    "  lines.push('');",
    "  lines.push('; Block table: (col, row) pairs');",
    "  lines.push('block_table:');",
    "  for (var i = 0; i < table.length; i++) {",
    "    lines.push('  db ' + table[i].col + ', ' + table[i].row);",
    "  }",
    "  lines.push('');",
    "  lines.push('loader_end:');",
    "  lines.push('');",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// ASM generator for Checkerboard scheme",
    "// -------------------------------------------------------------------",
    "function generateCheckerboardAsm(baseName, blockW, blockH, schemeName, incName) {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; Tape Loader: Checkerboard ' + blockW + 'x' + blockH + ' scheme',",
    "    '; ==========================================================',",
    "    '; The .scr on tape is reordered in checkerboard block order:',",
    "    '; even-positioned blocks first, then odd-positioned blocks.',",
    "    '; Each block is ' + blockW + ' cols x ' + blockH + ' rows of character cells.',",
    "    ';',",
    "    '; The .tap contains two blocks:',",
    "    ';   1. BASIC program (REM with loader MC + block table)',",
    "    ';   2. HEADLESS data: reordered screen (6912 bytes, flag $FE)',",
    "    ';',",
    "    '; Build with sjasmplus:',",
    "    ';   sjasmplus ' + baseName + '.asm',",
    "    ';',",
    "    '; Produces ' + baseName + '.tap',",
    "    '; ==========================================================',",
    "    '',",
    "    '  DEVICE ZXSPECTRUM48',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; Reordered screen data at $4000 (6912 bytes)',",
    "    '; ----------------------------------------------------------',",
    "    '  ORG $4000',",
    "    '',",
    "    'screen_data:',",
    "    '  INCBIN \"' + baseName + '.scr\"',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; BASIC program at PROG ($5CCB)',",
    "    ';',",
    "    '; Line 1: REM + loader MC + block table',",
    "    '; Line 10: RANDOMIZE USR 23760: PAUSE 0',",
    "    '; ----------------------------------------------------------',",
    "    '  ORG $5CCB',",
    "    '',",
    "    'basic_start:',",
    "    '',",
    "    '  ; === Line 1: REM + machine code + block table ===',",
    "    '  db $00, $01                     ; line number 1',",
    "    '  dw line1_end - line1_start      ; line length',",
    "    'line1_start:',",
    "    '  db $EA                          ; REM token',",
    "    '',",
    "    '  INCLUDE \"' + incName + '\"',",
    "    '',",
    "    '  db $0D                          ; ENTER (end of line 1)',",
    "    'line1_end:',",
    "    '',",
    "    '  ; === Line 10: RANDOMIZE USR 23760: PAUSE 0 ===',",
    "    '  db $00, $0A                     ; line number 10',",
    "    '  db line10_end - line10_start, $00 ; line length',",
    "    'line10_start:',",
    "    '  db $F9                          ; RANDOMIZE token',",
    "    '  db $C0                          ; USR token',",
    "    '  db \"23760\"',",
    "    '  db $0E, $00, $00, $D0, $5C, $00 ; 5-byte FP: 23760',",
    "    '  db \":\"',",
    "    '  db $F2                          ; PAUSE token',",
    "    '  db \"0\"',",
    "    '  db $0E, $00, $00, $00, $00, $00 ; 5-byte FP: 0',",
    "    '  db $0D                          ; ENTER',",
    "    'line10_end:',",
    "    '',",
    "    'basic_end:',",
    "    '  db $80                          ; end-of-variables marker',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; SAVETAP directives',",
    "    '; ----------------------------------------------------------',",
    "    '  SAVETAP \"' + baseName + '.tap\", BASIC, \"' + baseName.substring(0, 10) + '\", basic_start, basic_end + 1 - basic_start, 10',",
    "    '  SAVETAP \"' + baseName + '.tap\", HEADLESS, $4000, 6912, $FE',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// ASM generator for Linear scheme",
    "// -------------------------------------------------------------------",
    "function generateLinearLoaderInc() {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; linear_loader.inc',",
    "    '; Linear tape loader (top-to-bottom) for ZX Spectrum',",
    "    '; ==========================================================',",
    "    ';',",
    "    '; Loads screen data in character-row order: for each of the',",
    "    '; 24 character rows, reads 8 bitmap lines (256 bytes) then',",
    "    '; 32 attribute bytes. Visual effect: picture paints top to',",
    "    '; bottom with colors appearing after each row.',",
    "    ';',",
    "    '; Uses ROM routines for pilot/sync/byte reading:',",
    "    ';   $0562 - LD-BYTES from IN A,($FE): pilot + sync + flag',",
    "    ';   $05C6 - byte reader: reads one byte into L (DE must be 0)',",
    "    ';',",
    "    '; Usage:',",
    "    ';   Place inside a REM line so it starts at $5CD0 (23760).',",
    "    ';   Call with RANDOMIZE USR 23760.',",
    "    ';   The tape block must be HEADLESS with flag $FE.',",
    "    ';   The .scr data must be linearized (char-row order).',",
    "    ';',",
    "    '; Register strategy (matches backward loader pattern):',",
    "    ';   IX  = destination pointer (incremented for each byte)',",
    "    ';   DE  = 0 (required by ROM $05C6)',",
    "    ';   C\\' = char row counter (0-23)  (shadow registers are safe:',",
    "    ';   B\\' = pixel line counter        ROM $05C6 has no EXX)',",
    "    ';   H\\':L\\' = saved bitmap base address',",
    "    ';',",
    "    '; Labels provided:',",
    "    ';   loader_entry - entry point (must be at $5CD0)',",
    "    ';   loader_end   - end marker (for line length calculation)',",
    "    '; ==========================================================',",
    "    '',",
    "    'loader_entry:                      ; = $5CD0 (23760)',",
    "    '  di',",
    "    '',",
    "    '  ; --- Call ROM $0562 for pilot + sync + flag byte ---',",
    "    '  ld ix, $4000                    ; safe target for ROM flag store',",
    "    '  ld de, 0                        ; DE=0: return after flag byte',",
    "    '  xor a',",
    "    '  out ($FE), a                    ; black border',",
    "    '  call $0562                      ; ROM: pilot + sync + flag',",
    "    '',",
    "    '  ; --- Verify flag byte ---',",
    "    '  ld a, $FE                       ; our custom flag marker',",
    "    '  xor l',",
    "    '  jr nz, loader_entry             ; wrong flag, retry',",
    "    '',",
    "    '  ; --- Load 24 character rows ---',",
    "    '  ; DE stays 0 from $0562 call (required by $05C6)',",
    "    '  exx',",
    "    '  ld c, 0                         ; C\\' = char row (0-23)',",
    "    '  exx',",
    "    '',",
    "    'ld_row_loop:',",
    "    '  ; Compute bitmap start address for pixel line 0 of row C\\'',",
    "    '  ; High byte = $40 + (row & $18), low byte = (row & 7) * 32',",
    "    '  exx',",
    "    '  ld a, c',",
    "    '  and $18',",
    "    '  add a, $40',",
    "    '  ld h, a                         ; H\\' = high byte of bitmap addr',",
    "    '  ld a, c',",
    "    '  and $07',",
    "    '  rrca',",
    "    '  rrca',",
    "    '  rrca                            ; (row%8) * 32',",
    "    '  ld l, a                         ; L\\' = low byte of bitmap addr',",
    "    '  ld b, 8                         ; B\\' = 8 pixel lines',",
    "    '  exx',",
    "    '',",
    "    '  ; --- Read 8 pixel lines x 32 bytes ---',",
    "    'ld_pixel_loop:',",
    "    '  exx',",
    "    '  push hl                         ; save bitmap base H\\':L\\'',",
    "    '  push hl',",
    "    '  exx',",
    "    '  pop ix                          ; IX = pixel line address',",
    "    '',",
    "    '  ; Read 32 bytes using backward-loader pattern',",
    "    '  exx',",
    "    '  push bc                         ; save B\\'=pixel counter, C\\'=row',",
    "    '  ld b, 32                        ; B\\' = byte counter',",
    "    '  exx',",
    "    '',",
    "    'ld_bmp_byte:',",
    "    '  call $05C6                      ; ROM: read one byte into L',",
    "    '  ld (ix+0), l                    ; store byte',",
    "    '  inc ix',",
    "    '  exx',",
    "    '  dec b                           ; B\\' -= 1',",
    "    '  exx',",
    "    '  jr nz, ld_bmp_byte             ; loop while B\\' != 0',",
    "    '',",
    "    '  exx',",
    "    '  pop bc                          ; restore B\\'=pixel lines, C\\'=row',",
    "    '  pop hl                          ; restore bitmap base H\\':L\\'',",
    "    '  inc h                           ; H\\' += 1 (next pixel line = +$100)',",
    "    '  dec b                           ; B\\' -= 1',",
    "    '  exx',",
    "    '  jr nz, ld_pixel_loop           ; loop while B\\' != 0',",
    "    '',",
    "    '  ; --- Read 32 attribute bytes ---',",
    "    '  ; Attr address = $5800 + row * 32',",
    "    '  exx',",
    "    '  ld a, c                         ; A = C\\' (row)',",
    "    '  and $18',",
    "    '  rrca',",
    "    '  rrca',",
    "    '  rrca                            ; (row & $18) / 8 = third (0,1,2)',",
    "    '  add a, $58',",
    "    '  ld h, a                         ; H\\' = attr high byte',",
    "    '  ld a, c',",
    "    '  and $07',",
    "    '  rrca',",
    "    '  rrca',",
    "    '  rrca                            ; (row % 8) * 32',",
    "    '  ld l, a                         ; L\\' = attr low byte',",
    "    '  push hl',",
    "    '  exx',",
    "    '  pop ix                          ; IX = attr address',",
    "    '  exx',",
    "    '  ld b, 32                        ; B\\' = byte counter',",
    "    '  exx',",
    "    '',",
    "    'ld_attr_byte:',",
    "    '  call $05C6                      ; ROM: read one byte into L',",
    "    '  ld (ix+0), l',",
    "    '  inc ix',",
    "    '  exx',",
    "    '  dec b                           ; B\\' -= 1',",
    "    '  exx',",
    "    '  jr nz, ld_attr_byte            ; loop while B\\' != 0',",
    "    '',",
    "    '  ; --- Next character row ---',",
    "    '  exx',",
    "    '  inc c                           ; C\\' += 1',",
    "    '  ld a, c',",
    "    '  cp 24',",
    "    '  exx',",
    "    '  jp nz, ld_row_loop',",
    "    '',",
    "    '  ; --- Read checksum byte (ignore result) ---',",
    "    '  ld ix, $4000                    ; safe target for checksum store',",
    "    '  call $05C6',",
    "    '',",
    "    '  ei',",
    "    '  ret',",
    "    '',",
    "    'loader_end:',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "function generateLinearAsm(baseName) {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; Tape Loader: Linear scheme (top-to-bottom)',",
    "    '; ==========================================================',",
    "    '; The .scr on tape is linearized in character-row order:',",
    "    '; for each row, 8 bitmap lines then 32 attr bytes.',",
    "    '; Visual effect: picture paints top to bottom with colors',",
    "    '; appearing after each character row.',",
    "    ';',",
    "    '; The .tap contains two blocks:',",
    "    ';   1. BASIC program (REM with loader MC)',",
    "    ';   2. HEADLESS data: linearized screen (6912 bytes, flag $FE)',",
    "    ';',",
    "    '; Build with sjasmplus:',",
    "    ';   sjasmplus ' + baseName + '.asm',",
    "    ';',",
    "    '; Produces ' + baseName + '.tap',",
    "    '; ==========================================================',",
    "    '',",
    "    '  DEVICE ZXSPECTRUM48',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; Linearized screen data at $4000 (6912 bytes)',",
    "    '; ----------------------------------------------------------',",
    "    '  ORG $4000',",
    "    '',",
    "    'screen_data:',",
    "    '  INCBIN \"' + baseName + '.scr\"',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; BASIC program at PROG ($5CCB)',",
    "    ';',",
    "    '; Line 1: REM + loader MC',",
    "    '; Line 10: RANDOMIZE USR 23760: PAUSE 0',",
    "    ';',",
    "    '; USR 23760 runs the loader at $5CD0 which uses ROM routines',",
    "    '; for tape I/O (timing-critical code runs from ROM).',",
    "    '; ----------------------------------------------------------',",
    "    '  ORG $5CCB',",
    "    '',",
    "    'basic_start:',",
    "    '',",
    "    '  ; === Line 1: REM + machine code ===',",
    "    '  db $00, $01                     ; line number 1',",
    "    '  db line1_end - line1_start, $00 ; line length',",
    "    'line1_start:',",
    "    '  db $EA                          ; REM token',",
    "    '',",
    "    '  INCLUDE \"linear_loader.inc\"',",
    "    '',",
    "    '  db $0D                          ; ENTER (end of line 1)',",
    "    'line1_end:',",
    "    '',",
    "    '  ; === Line 10: RANDOMIZE USR 23760: PAUSE 0 ===',",
    "    '  db $00, $0A                     ; line number 10',",
    "    '  db line10_end - line10_start, $00 ; line length',",
    "    'line10_start:',",
    "    '  db $F9                          ; RANDOMIZE token',",
    "    '  db $C0                          ; USR token',",
    "    '  db \"23760\"',",
    "    '  db $0E, $00, $00, $D0, $5C, $00 ; 5-byte FP: 23760',",
    "    '  db \":\"',",
    "    '  db $F2                          ; PAUSE token',",
    "    '  db \"0\"',",
    "    '  db $0E, $00, $00, $00, $00, $00 ; 5-byte FP: 0',",
    "    '  db $0D                          ; ENTER',",
    "    'line10_end:',",
    "    '',",
    "    'basic_end:',",
    "    '  db $80                          ; end-of-variables marker',",
    "    '',",
    "    '; ----------------------------------------------------------',",
    "    '; SAVETAP directives',",
    "    '; ----------------------------------------------------------',",
    "    '  SAVETAP \"' + baseName + '.tap\", BASIC, \"' + baseName.substring(0, 10) + '\", basic_start, basic_end + 1 - basic_start, 10',",
    "    '  SAVETAP \"' + baseName + '.tap\", HEADLESS, $4000, 6912, $FE',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Scheme 6: Turbo Linear (TZX with custom edge-detect loader)",
    "// -------------------------------------------------------------------",
    "",
    "// Pre-assembled turbo loader (165 bytes = 14-byte stub + 151-byte loader).",
    "// Based on turbo loading technique from zxctl by iratahack:",
    "//   https://github.com/iratahack/zxctl/tree/develop",
    "//",
    "// The stub lives in the REM line at $5CD0 (23760). It copies the loader",
    "// to $8000 (uncontended RAM) via LDIR, then JP $8000.",
    "// Running in uncontended RAM gives a clean ~52 T/iter edge loop.",
    "//",
    "// On completion or error, the loader returns to BASIC via RST $08",
    "// (ROM error restart) with code $FF = report '0 OK'. The ROM error",
    "// handler resets SP from ERR_SP, so no register save/restore is needed.",
    "//",
    "// Threshold=12, edge loop ~52 T/iter at $8000:",
    "//   Zero (427T): B~8  < 12 (margin 4)",
    "//   One  (855T): B~16 > 12 (margin 4)",
    "//   Pilot(1084T): B~20 > 12",
    "//",
    "// IX starts at $3FFF so the flag byte writes to ROM (harmlessly ignored),",
    "// screen data lands at $4000-$5AFF, checksum at $5B00 (printer buffer).",
    "var TURBO_LOADER_MC = [",
    "  // --- Stub (14 bytes): copy loader to $8000, jump there ---",
    "  // ld hl,$5CDE; ld de,$8000; ld bc,152; ldir; jp $8000",
    "  0x21, 0xDE, 0x5C, 0x11, 0x00, 0x80, 0x01, 0x98, 0x00, 0xED, 0xB0, 0xC3, 0x00, 0x80,",
    "  // --- Loader (152 bytes, assembled for $8000, uncontended) ---",
    "  // di; xor a; out ($FE),a; ld a,$7F; in a,($FE); and $40; ld c,a",
    "  0xF3, 0xAF, 0xD3, 0xFE, 0x3E, 0x7F, 0xDB, 0xFE, 0xE6, 0x40, 0x4F,",
    "  // pilot_detect: ld d,64; pilot_edge: ld b,0",
    "  0x16, 0x40, 0x06, 0x00,",
    "  // pe_loop: inc b; jr z,pilot_detect; ld a,$7F; in a,($FE); xor c; and $40; jr z,pe_loop",
    "  0x04, 0x28, 0xF9, 0x3E, 0x7F, 0xDB, 0xFE, 0xA9, 0xE6, 0x40, 0x28, 0xF4,",
    "  // toggle; cp 12; jr c,pilot_detect; dec d; jr nz,pilot_edge",
    "  0x79, 0xEE, 0x40, 0x4F, 0x78, 0xFE, 0x0C, 0x38, 0xE7, 0x15, 0x20, 0xE6,",
    "  // sync1: ld b,0; s1_loop: inc b; jr z,err; ...; jr z,s1_loop",
    "  0x06, 0x00, 0x04, 0x28, 0x64, 0x3E, 0x7F, 0xDB, 0xFE, 0xA9, 0xE6, 0x40, 0x28, 0xF4,",
    "  // toggle; cp 12; jr nc,sync1",
    "  0x79, 0xEE, 0x40, 0x4F, 0x78, 0xFE, 0x0C, 0x30, 0xE9,",
    "  // sync2: ld b,0; s2_loop: inc b; jr z,err; ...; jr z,s2_loop; toggle",
    "  0x06, 0x00, 0x04, 0x28, 0x4D, 0x3E, 0x7F, 0xDB, 0xFE, 0xA9, 0xE6, 0x40, 0x28, 0xF4,",
    "  0x79, 0xEE, 0x40, 0x4F,",
    "  // ld ix,$3FFF; ld de,6914; data_byte: ld l,8; bit_loop: ld b,0",
    "  0xDD, 0x21, 0xFF, 0x3F, 0x11, 0x02, 0x1B, 0x2E, 0x08, 0x06, 0x00,",
    "  // e1: inc b; jr z,err; ...; jr z,e1; toggle; cp 12; ccf; rl h",
    "  0x04, 0x28, 0x32, 0x3E, 0x7F, 0xDB, 0xFE, 0xA9, 0xE6, 0x40, 0x28, 0xF4,",
    "  0x79, 0xEE, 0x40, 0x4F, 0x78, 0xFE, 0x0C, 0x3F, 0xCB, 0x14,",
    "  // ld b,0; e2: inc b; jr z,err; ...; jr z,e2; toggle",
    "  0x06, 0x00, 0x04, 0x28, 0x1A, 0x3E, 0x7F, 0xDB, 0xFE, 0xA9, 0xE6, 0x40, 0x28, 0xF4,",
    "  0x79, 0xEE, 0x40, 0x4F,",
    "  // dec l; jr nz,bit_loop; ld (ix+0),h; inc ix; dec de; ld a,d; or e; jr nz,data_byte",
    "  0x2D, 0x20, 0xD3, 0xDD, 0x74, 0x00, 0xDD, 0x23, 0x1B, 0x7A, 0xB3, 0x20, 0xC7,",
    "  // load_err: ld iy,$5C3A; ei; halt; rst $08; db $FF ('0 OK')",
    "  0xFD, 0x21, 0x3A, 0x5C, 0xFB, 0x76, 0xCF, 0xFF",
    "];",
    "",
    "// -------------------------------------------------------------------",
    "// Build complete TZX file with BASIC loader + turbo data block",
    "// -------------------------------------------------------------------",
    "function buildTzxFile(scrData) {",
    "  // --- BASIC program bytes ---",
    "  // Line 1: REM + turbo MC",
    "  var mc = TURBO_LOADER_MC;",
    "  var line1Body = [0xEA]; // REM token",
    "  for (var i = 0; i < mc.length; i++) line1Body.push(mc[i]);",
    "  line1Body.push(0x0D); // ENTER",
    "  var line1Len = line1Body.length;",
    "",
    "  // Line 10: RANDOMIZE USR 23760",
    "  var line10Body = [",
    "    0xF9, 0xC0,                             // RANDOMIZE USR",
    "    0x32, 0x33, 0x37, 0x36, 0x30,           // '23760'",
    "    0x0E, 0x00, 0x00, 0xD0, 0x5C, 0x00,     // FP: 23760",
    "    0x0D                                      // ENTER",
    "  ];",
    "  var line10Len = line10Body.length;",
    "",
    "  // Assemble BASIC program",
    "  var basic = [];",
    "  // Line 1 header: number(2) + length(2)",
    "  basic.push(0x00, 0x01);                    // line number 1",
    "  basic.push(line1Len & 0xFF, (line1Len >> 8) & 0xFF);",
    "  for (var i = 0; i < line1Body.length; i++) basic.push(line1Body[i]);",
    "  // Line 10 header",
    "  basic.push(0x00, 0x0A);                    // line number 10",
    "  basic.push(line10Len & 0xFF, (line10Len >> 8) & 0xFF);",
    "  for (var i = 0; i < line10Body.length; i++) basic.push(line10Body[i]);",
    "  // End-of-variables marker",
    "  basic.push(0x80);",
    "",
    "  // --- TAP block for BASIC (flag $00) ---",
    "  var basicLen = basic.length;",
    "  // Standard TAP header block (type 0 = Program)",
    "  var headerData = new Uint8Array(17);",
    "  var hv = new DataView(headerData.buffer);",
    "  headerData[0] = 0x00;                      // type: Program",
    "  // filename: 10 bytes, padded with spaces",
    "  var fname = 'turboload';",
    "  for (var i = 0; i < 10; i++) headerData[1 + i] = i < fname.length ? fname.charCodeAt(i) : 0x20;",
    "  hv.setUint16(11, basicLen, true);           // data length (program + variables)",
    "  hv.setUint16(13, 10, true);                 // autostart line 10",
    "  hv.setUint16(15, basicLen - 1, true);       // program length (excluding $80 vars marker)",
    "",
    "  // --- TZX structure ---",
    "  var parts = [];",
    "  var totalLen = 0;",
    "  function addBytes(arr) {",
    "    var u = (arr instanceof Uint8Array) ? arr : new Uint8Array(arr);",
    "    parts.push(u);",
    "    totalLen += u.length;",
    "  }",
    "",
    "  // TZX header (10 bytes)",
    "  addBytes([0x5A, 0x58, 0x54, 0x61, 0x70, 0x65, 0x21, 0x1A, 0x01, 0x14]);",
    "",
    "  // Block 0x10 #1: Standard speed — TAP header",
    "  // flag($00) + 17 header bytes + checksum = 19 bytes",
    "  var tapHeader = new Uint8Array(19);",
    "  tapHeader[0] = 0x00; // flag",
    "  tapHeader.set(headerData, 1);",
    "  var hxor = 0x00;",
    "  for (var i = 0; i < 18; i++) hxor ^= tapHeader[i];",
    "  tapHeader[18] = hxor;",
    "",
    "  addBytes([0x10]);                           // block ID",
    "  addBytes([0xE8, 0x03]);                     // pause 1000ms",
    "  addBytes([tapHeader.length & 0xFF, (tapHeader.length >> 8) & 0xFF]);",
    "  addBytes(tapHeader);",
    "",
    "  // Block 0x10 #2: Standard speed — BASIC data",
    "  // flag($FF) + basic bytes + checksum",
    "  var tapData = new Uint8Array(2 + basicLen);",
    "  tapData[0] = 0xFF; // flag",
    "  for (var i = 0; i < basicLen; i++) tapData[1 + i] = basic[i];",
    "  var dxor = 0xFF;",
    "  for (var i = 0; i < basicLen; i++) dxor ^= basic[i];",
    "  tapData[1 + basicLen] = dxor;",
    "",
    "  addBytes([0x10]);                           // block ID",
    "  addBytes([0x01, 0x00]);                     // pause 1ms (short: MC must start before pilot ends)",
    "  addBytes([tapData.length & 0xFF, (tapData.length >> 8) & 0xFF]);",
    "  addBytes(tapData);",
    "",
    "  // Block 0x11: Turbo speed — screen data",
    "  // Data: flag($FF) + 6912 screen bytes + XOR checksum = 6914 bytes",
    "  var turboData = new Uint8Array(6914);",
    "  turboData[0] = 0xFF; // flag byte",
    "  turboData.set(scrData.subarray ? scrData.subarray(0, 6912) : new Uint8Array(scrData).slice(0, 6912), 1);",
    "  var txor = 0xFF;",
    "  for (var i = 0; i < 6912; i++) txor ^= turboData[1 + i];",
    "  turboData[6913] = txor;",
    "",
    "  var turboDataLen = turboData.length; // 6914",
    "  var block11 = new Uint8Array(19 + turboDataLen);",
    "  var bv = new DataView(block11.buffer);",
    "  block11[0] = 0x11;                          // block ID",
    "  bv.setUint16(1, 1084, true);                // pilot pulse: 1084 T",
    "  bv.setUint16(3, 333, true);                 // sync 1: 333 T",
    "  bv.setUint16(5, 368, true);                 // sync 2: 368 T",
    "  bv.setUint16(7, 427, true);                 // zero bit: 427 T",
    "  bv.setUint16(9, 855, true);                 // one bit: 855 T",
    "  bv.setUint16(11, 4096, true);               // pilot tone pulses",
    "  block11[13] = 8;                            // used bits in last byte",
    "  bv.setUint16(14, 1000, true);               // pause after block: 1000ms (silence lets loader timeout to RST $08)",
    "  // data length: 3 bytes (little-endian 24-bit)",
    "  block11[16] = turboDataLen & 0xFF;",
    "  block11[17] = (turboDataLen >> 8) & 0xFF;",
    "  block11[18] = (turboDataLen >> 16) & 0xFF;",
    "  block11.set(turboData, 19);",
    "",
    "  addBytes(block11);",
    "",
    "  // Block 0x2A: Stop the Tape if in 48K mode",
    "  // Tells the emulator to stop tape motor after turbo block.",
    "  // Without this, some emulators keep tape active and hang.",
    "  addBytes([0x2A, 0x00, 0x00, 0x00, 0x00]);",
    "",
    "  // Concatenate all parts",
    "  var result = new Uint8Array(totalLen);",
    "  var pos = 0;",
    "  for (var i = 0; i < parts.length; i++) {",
    "    result.set(parts[i], pos);",
    "    pos += parts[i].length;",
    "  }",
    "  return result;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// ASM reference source for Turbo Linear scheme",
    "// -------------------------------------------------------------------",
    "function generateTurboAsm(baseName) {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; Tape Loader: Turbo Linear (2\\u00d7 speed, TZX)',",
    "    '; Generated by SpectraLab (Tape Loader Schemes plugin)',",
    "    '; Based on turbo loading technique from zxctl by iratahack:',",
    "    ';   https://github.com/iratahack/zxctl/tree/develop',",
    "    '; ==========================================================',",
    "    '; The .tzx contains two blocks:',",
    "    ';   1. Block $10 (standard speed): BASIC program with turbo',",
    "    ';      loader MC in a REM line. ROM loads this normally.',",
    "    ';   2. Block $11 (turbo speed): flag + 6912 screen bytes +',",
    "    ';      XOR checksum. The MC reads this via edge detection.',",
    "    ';',",
    "    '; The screen data is in standard SCR layout (no reordering).',",
    "    '; The turbo MC writes bytes sequentially to $4000\\u2013$5AFF.',",
    "    ';',",
    "    '; NOTE: This .asm is for reference only. The .tzx is built',",
    "    '; directly by SpectraLab (TZX block $11 requires special',",
    "    '; timing parameters that SAVETAP cannot express).',",
    "    '; ==========================================================',",
    "    '',",
    "    '; --- TZX Block $11 timing (half of standard ROM values) ---',",
    "    '; Pilot pulse:  1084 T-states (standard: 2168)',",
    "    '; Sync 1 pulse:  333 T-states (standard:  667)',",
    "    '; Sync 2 pulse:  368 T-states (standard:  735)',",
    "    '; Zero-bit pulse: 427 T-states (standard:  855)',",
    "    '; One-bit pulse:  855 T-states (standard: 1710)',",
    "    '; Pilot pulses:  4096         (standard: 3223)',",
    "    ';',",
    "    '; The REM stub copies the loader to $8000 (uncontended RAM)',",
    "    '; via LDIR, then JP $8000. Edge loop ~52 T/iter at $8000.',",
    "    '; Threshold=12: zero B~8 < 12, one B~16 > 12, pilot B~20 > 12.',",
    "    '',",
    "    'THRESHOLD EQU 12            ; edge timing threshold',",
    "    '',",
    "    '  DEVICE ZXSPECTRUM48',",
    "    '  ORG $5CCB',",
    "    '',",
    "    'basic_start:',",
    "    '',",
    "    '  ; === Line 1: REM + turbo loader MC ===',",
    "    '  db $00, $01                     ; line number 1',",
    "    '  dw line1_end - line1_start      ; line length',",
    "    'line1_start:',",
    "    '  db $EA                          ; REM token',",
    "    '',",
    "    '  INCLUDE \"turbo_loader.inc\"',",
    "    '',",
    "    '  db $0D                          ; ENTER',",
    "    'line1_end:',",
    "    '',",
    "    '  ; === Line 10: RANDOMIZE USR 23760 ===',",
    "    '  db $00, $0A                     ; line number 10',",
    "    '  db line10_end - line10_start, $00 ; line length',",
    "    'line10_start:',",
    "    '  db $F9                          ; RANDOMIZE token',",
    "    '  db $C0                          ; USR token',",
    "    '  db \"23760\"',",
    "    '  db $0E, $00, $00, $D0, $5C, $00 ; 5-byte FP: 23760',",
    "    '  db $0D                          ; ENTER',",
    "    'line10_end:',",
    "    '',",
    "    'basic_end:',",
    "    '  db $80                          ; end-of-variables marker',",
    "    '',",
    "    '; NOTE: The TZX file is built by SpectraLab, not sjasmplus.',",
    "    '; Block $10 contains the BASIC program above (standard speed).',",
    "    '; Block $11 contains flag($FF) + ' + baseName + '.scr + checksum',",
    "    '; at turbo timing. The MC in the REM line reads it directly.',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Turbo loader .inc (commented assembly source for reference)",
    "// -------------------------------------------------------------------",
    "function generateTurboLoaderInc() {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; turbo_loader.inc',",
    "    '; Turbo tape loader for ZX Spectrum (TZX block $11)',",
    "    '; Generated by SpectraLab (Tape Loader Schemes plugin)',",
    "    '; Based on turbo loading technique from zxctl by iratahack:',",
    "    ';   https://github.com/iratahack/zxctl/tree/develop',",
    "    '; ==========================================================',",
    "    ';',",
    "    '; Custom edge-detection loader that reads data at ~2\\u00d7 speed.',",
    "    '; Unlike the standard ROM routines, this code measures pulse',",
    "    '; widths directly and uses a threshold to distinguish 0/1 bits.',",
    "    ';',",
    "    '; Architecture: the MC lives inside a BASIC REM line at $5CD0.',",
    "    '; A 14-byte stub copies the loader body to $8000 (uncontended RAM)',",
    "    '; via LDIR, then JP $8000. This avoids ULA contention in',",
    "    '; $4000\\u2013$7FFF that would distort edge timing.',",
    "    ';',",
    "    '; Return to BASIC: uses RST $08 (ROM error restart) with error',",
    "    '; code $FF to trigger the \\\"0 OK\\\" report. The ROM error handler',",
    "    '; resets SP from ERR_SP ($5C3D), so no register save/restore or',",
    "    '; stack cleanup is needed. IY is restored to $5C3A for ROM.',",
    "    ';',",
    "    '; Turbo timing (half of ROM values):',",
    "    ';   Pilot pulse:  1084 T   Zero-bit pulse: 427 T',",
    "    ';   Sync 1 pulse:  333 T   One-bit pulse:  855 T',",
    "    ';   Sync 2 pulse:  368 T   Pilot count:   4096',",
    "    ';',",
    "    '; Edge loop is ~52 T/iteration at $8000 (uncontended), so:',",
    "    ';   Zero count \\u2248 8, One count \\u2248 16, Threshold = 12',",
    "    ';',",
    "    '; Register plan (loader body at $8000):',",
    "    ';   C  = current EAR state (bit 6 of port $FE)',",
    "    ';   IX = destination pointer ($3FFF\\u2013$5AFF)',",
    "    ';   DE = byte counter (6914 = flag + 6912 data + checksum)',",
    "    ';   H  = byte accumulator',",
    "    ';   L  = bit counter (8 bits per byte)',",
    "    ';   B  = edge timing counter',",
    "    ';   A  = scratch',",
    "    ';',",
    "    '; IX starts at $3FFF so the first byte (flag $FF) writes to',",
    "    '; ROM (silently ignored), and screen data lands at $4000+.',",
    "    ';',",
    "    '; Labels provided:',",
    "    ';   stub_entry  - entry point at $5CD0 (called by RANDOMIZE USR 23760)',",
    "    ';   loader_body - loader code (relocated to $8000 at runtime)',",
    "    ';   loader_end  - end of loader body',",
    "    '; ==========================================================',",
    "    '',",
    "    'DEST      EQU $8000',",
    "    'THRESHOLD EQU 12',",
    "    '',",
    "    '; === Stub: copy loader to $8000 and jump there ===',",
    "    '; No register save needed: RST $08 resets SP from ERR_SP',",
    "    'stub_entry:                        ; = $5CD0 (23760)',",
    "    '  ld hl, loader_body               ; source: right after stub',",
    "    '  ld de, DEST                      ; destination: $8000',",
    "    '  ld bc, loader_end - loader_body  ; size of loader',",
    "    '  ldir',",
    "    '  jp DEST',",
    "    '',",
    "    '; === Loader body (assembled for DEST=$8000, copied there by stub) ===',",
    "    'loader_body:',",
    "    '  ; Note: all JR targets below are relative, so they work at $8000',",
    "    '  ; even though they appear here right after the stub.',",
    "    '  ; Use DISP DEST / ENT in sjasmplus to assemble for $8000.',",
    "    '',",
    "    '  di',",
    "    '',",
    "    '  ; --- Black border + read initial EAR state ---',",
    "    '  xor a',",
    "    '  out ($FE), a',",
    "    '  ld a, $7F',",
    "    '  in a, ($FE)',",
    "    '  and $40                         ; isolate EAR bit',",
    "    '  ld c, a                         ; C = current EAR state',",
    "    '',",
    "    '  ; ========= Pilot detection =========',",
    "    '  ; Wait for 64 consecutive long pulses',",
    "    'pilot_detect:',",
    "    '  ld d, 64                        ; need 64 good pilot pulses',",
    "    '',",
    "    'pilot_edge:',",
    "    '  ld b, 0                         ; reset timing counter',",
    "    '',",
    "    'pe_loop:',",
    "    '  inc b',",
    "    '  jr z, pilot_detect               ; timeout: retry pilot detection',",
    "    '  ld a, $7F',",
    "    '  in a, ($FE)',",
    "    '  xor c                           ; compare with current state',",
    "    '  and $40                         ; check EAR bit changed',",
    "    '  jr z, pe_loop                   ; no change, keep counting',",
    "    '',",
    "    '  ld a, c',",
    "    '  xor $40',",
    "    '  ld c, a                         ; toggle EAR state',",
    "    '',",
    "    '  ld a, b',",
    "    '  cp THRESHOLD',",
    "    '  jr c, pilot_detect              ; short pulse: restart count',",
    "    '  dec d',",
    "    '  jr nz, pilot_edge               ; long pulse: count it',",
    "    '',",
    "    '  ; ========= Sync detection =========',",
    "    '  ; Wait for first short pulse after pilot',",
    "    'sync1:',",
    "    '  ld b, 0',",
    "    '',",
    "    's1_loop:',",
    "    '  inc b',",
    "    '  jr z, load_err',",
    "    '  ld a, $7F',",
    "    '  in a, ($FE)',",
    "    '  xor c',",
    "    '  and $40',",
    "    '  jr z, s1_loop',",
    "    '',",
    "    '  ld a, c',",
    "    '  xor $40',",
    "    '  ld c, a',",
    "    '',",
    "    '  ld a, b',",
    "    '  cp THRESHOLD',",
    "    '  jr nc, sync1                    ; still pilot, keep waiting',",
    "    '',",
    "    '  ; Wait for second sync edge',",
    "    'sync2:',",
    "    '  ld b, 0',",
    "    '',",
    "    's2_loop:',",
    "    '  inc b',",
    "    '  jr z, load_err',",
    "    '  ld a, $7F',",
    "    '  in a, ($FE)',",
    "    '  xor c',",
    "    '  and $40',",
    "    '  jr z, s2_loop',",
    "    '',",
    "    '  ld a, c',",
    "    '  xor $40',",
    "    '  ld c, a',",
    "    '',",
    "    '  ; ========= Data reading =========',",
    "    '  ; Read 6914 bytes: flag + 6912 screen + checksum',",
    "    '  ; IX=$3FFF: first byte (flag) writes to ROM (ignored),',",
    "    '  ; then screen data lands at $4000\\u2013$5AFF correctly.',",
    "    '  ld ix, $3FFF                    ; destination pointer - 1',",
    "    '  ld de, 6914                     ; total bytes to read',",
    "    '',",
    "    'data_byte:',",
    "    '  ld l, 8                         ; 8 bits per byte',",
    "    '',",
    "    'bit_loop:',",
    "    '  ; --- First half-pulse: measure timing ---',",
    "    '  ld b, 0',",
    "    '',",
    "    'e1:',",
    "    '  inc b',",
    "    '  jr z, load_err',",
    "    '  ld a, $7F',",
    "    '  in a, ($FE)',",
    "    '  xor c',",
    "    '  and $40',",
    "    '  jr z, e1',",
    "    '',",
    "    '  ld a, c',",
    "    '  xor $40',",
    "    '  ld c, a                         ; toggle state',",
    "    '',",
    "    '  ld a, b',",
    "    '  cp THRESHOLD                    ; CF=1 if B<12 (short=0)',",
    "    '  ccf                             ; CF=1 if B>=12 (long=1)',",
    "    '  rl h                            ; shift bit into accumulator',",
    "    '',",
    "    '  ; --- Second half-pulse: just wait, don\\'t measure ---',",
    "    '  ld b, 0',",
    "    '',",
    "    'e2:',",
    "    '  inc b',",
    "    '  jr z, load_err',",
    "    '  ld a, $7F',",
    "    '  in a, ($FE)',",
    "    '  xor c',",
    "    '  and $40',",
    "    '  jr z, e2',",
    "    '',",
    "    '  ld a, c',",
    "    '  xor $40',",
    "    '  ld c, a                         ; toggle state',",
    "    '',",
    "    '  dec l',",
    "    '  jr nz, bit_loop                 ; next bit',",
    "    '',",
    "    '  ; --- Store complete byte ---',",
    "    '  ld (ix+0), h',",
    "    '  inc ix',",
    "    '  dec de',",
    "    '  ld a, d',",
    "    '  or e',",
    "    '  jr nz, data_byte               ; next byte',",
    "    '',",
    "    '  ; ========= Done / Error: return to BASIC via ROM error handler =========',",
    "    '  ; RST $08 + DB $FF triggers \\\"0 OK\\\" report.',",
    "    '  ; The ROM error handler resets SP from ERR_SP ($5C3D),',",
    "    '  ; so no register save/restore or stack cleanup is needed.',",
    "    'load_err:',",
    "    '  ld iy, $5C3A                    ; restore IY for ROM',",
    "    '  ei',",
    "    '  halt                            ; wait one frame (lets emulator exit tape-play mode)',",
    "    '  rst $08                         ; ROM error restart',",
    "    '  db $FF                          ; error code $FF = report \\\"0 OK\\\"',",
    "    '',",
    "    'loader_end:',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Disk Emulator ASM generators",
    "// -------------------------------------------------------------------",
    "// The disk emulator reads from a RAM buffer (INCBIN .scr) instead of",
    "// tape, producing the same visual effect. Press any key during the",
    "// reveal to skip the HALT pauses (SMC patches HALT to NOP).",
    "// Same reordered .scr is used by both tape and disk ASMs.",
    "",
    "function generateCheckKeySub() {",
    "  // Single HALT per call — ULA draws screen each frame, so each",
    "  // HALT = 1 frame = ~20ms. Speed is controlled by bytes-per-call.",
    "  return [",
    "    'check_key:',",
    "    '    ei                              ; enable interrupts for HALT',",
    "    'halt_patch:',",
    "    '    halt                            ; patched to NOP ($00) on keypress',",
    "    '    di                              ; disable interrupts again',",
    "    '    ld a, $7F                       ; keyboard row SPACE-B-N-M-SS',",
    "    '    in a, ($FE)',",
    "    '    and $1F',",
    "    '    cp $1F                          ; all 5 bits high = no key',",
    "    '    ret z                           ; no key pressed, return',",
    "    '    ; Key pressed: patch HALT to NOP via SMC',",
    "    '    xor a                           ; A = $00 = NOP opcode',",
    "    '    ld (halt_patch), a',",
    "    '    ret'",
    "  ];",
    "}",
    "",
    "function generateBackwardDiskInc() {",
    "  // ULA draws screen every frame, so bytes appear each frame.",
    "  // Write 4 bytes per HALT (≈ tape's ~3.4 bytes/frame).",
    "  // 6912 / 4 = 1728 HALTs = 1728 frames ≈ 34.6s at 50fps",
    "  var lines = [];",
    "  lines.push('; ==========================================================');",
    "  lines.push('; disk_backward_loader.inc');",
    "  lines.push('; Backward disk emulator ($5AFF->$4000) for ZX Spectrum');",
    "  lines.push('; ==========================================================');",
    "  lines.push(';');",
    "  lines.push('; Same visual effect as the backward tape loader: attrs');",
    "  lines.push('; appear first (bottom to top), then bitmap fills from');",
    "  lines.push('; bottom up. Reads from a RAM buffer instead of tape.');",
    "  lines.push(';');",
    "  lines.push('; Press any key during the reveal to show the remaining');",
    "  lines.push('; screen instantly (HALT is patched to NOP via SMC).');",
    "  lines.push(';');",
    "  lines.push('; Register plan:');",
    "  lines.push(';   HL  = source buffer pointer (incremented)');",
    "  lines.push(';   DE  = destination screen address (decremented)');",
    "  lines.push(';   B   = inner byte counter (4 bytes per group)');",
    "  lines.push(\";   HL' = iteration counter (1728 iterations)\");",
    "  lines.push('; ==========================================================');",
    "  lines.push('');",
    "  lines.push('disk_entry:');",
    "  lines.push('    di');",
    "  lines.push('    ld hl, screen_data           ; source pointer');",
    "  lines.push('    ld de, $5AFF                 ; destination (top of screen)');",
    "  lines.push('    exx');",
    "  lines.push('    ld hl, 1728                  ; 6912 / 4 = 1728 iterations');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_outer:');",
    "  lines.push('    ld b, 4                      ; 4 bytes per iteration');",
    "  lines.push('ld_inner:');",
    "  lines.push('    ld a, (hl)');",
    "  lines.push('    inc hl');",
    "  lines.push('    ld (de), a');",
    "  lines.push('    dec de');",
    "  lines.push('    djnz ld_inner');",
    "  lines.push('');",
    "  lines.push('    call check_key               ; 1 HALT per 4 bytes');",
    "  lines.push('');",
    "  lines.push('    exx');",
    "  lines.push('    dec hl');",
    "  lines.push('    ld a, h');",
    "  lines.push('    or l');",
    "  lines.push('    exx');",
    "  lines.push('    jr nz, ld_outer');",
    "  lines.push('');",
    "  lines.push('    ei');",
    "  lines.push('    ret');",
    "  lines.push('');",
    "  var checkKey = generateCheckKeySub();",
    "  for (var i = 0; i < checkKey.length; i++) lines.push(checkKey[i]);",
    "  lines.push('');",
    "  return lines.join('\\n');",
    "}",
    "",
    "function generateLinearDiskInc() {",
    "  // ULA draws screen every frame, so bytes appear each frame.",
    "  // Write 4 bytes per HALT (≈ tape's ~3.4 bytes/frame).",
    "  // 24 rows * (8 plines * 8 groups + 8 attr groups) = 24*72 = 1728 HALTs ≈ 34.6s",
    "  var lines = [];",
    "  lines.push('; ==========================================================');",
    "  lines.push('; disk_linear_loader.inc');",
    "  lines.push('; Linear disk emulator (top-to-bottom) for ZX Spectrum');",
    "  lines.push('; ==========================================================');",
    "  lines.push(';');",
    "  lines.push('; Same visual effect as the linear tape loader: picture');",
    "  lines.push('; paints top to bottom with colors appearing after each');",
    "  lines.push('; character row. Reads from a RAM buffer instead of tape.');",
    "  lines.push(';');",
    "  lines.push('; Press any key during the reveal to show the remaining');",
    "  lines.push('; screen instantly (HALT is patched to NOP via SMC).');",
    "  lines.push(';');",
    "  lines.push('; Register plan:');",
    "  lines.push(';   HL  = source buffer pointer (incremented)');",
    "  lines.push(';   DE  = destination screen address');",
    "  lines.push(';   B   = inner byte counter (4 bytes per group)');",
    "  lines.push(';   C   = group counter (8 groups = 32 bytes)');",
    "  lines.push(\";   C'  = char row counter (0-23)\");",
    "  lines.push(\";   B'  = pixel line counter\");",
    "  lines.push('; ==========================================================');",
    "  lines.push('');",
    "  lines.push('disk_entry:');",
    "  lines.push('    di');",
    "  lines.push('    ld hl, screen_data           ; HL = source buffer');",
    "  lines.push('    exx');",
    "  lines.push('    ld c, 0                      ; C\\' = char row (0-23)');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_row_loop:');",
    "  lines.push('    ; Compute bitmap address for pixel line 0 of row C\\'');",
    "  lines.push('    exx');",
    "  lines.push('    ld a, c');",
    "  lines.push('    and $18');",
    "  lines.push('    add a, $40                   ; high byte = $40 + (row & $18)');",
    "  lines.push('    ld d, a                      ; D\\' = high byte');",
    "  lines.push('    ld a, c');",
    "  lines.push('    and $07');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca                          ; (row % 8) * 32');",
    "  lines.push('    ld e, a                      ; E\\' = low byte');",
    "  lines.push('    ld b, 8                      ; B\\' = 8 pixel lines');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_pixel_loop:');",
    "  lines.push('    exx');",
    "  lines.push('    push de                      ; save pixel line address');",
    "  lines.push('    push bc                      ; save B\\'=pline counter, C\\'=row');",
    "  lines.push('    push de                      ; copy for transfer to main DE');",
    "  lines.push('    exx');",
    "  lines.push('    pop de                       ; DE = pixel line address');",
    "  lines.push('');",
    "  lines.push('    ; Copy 32 bytes in groups of 4, HALT between each');",
    "  lines.push('    ld c, 8                      ; 32/4 = 8 groups');",
    "  lines.push('ld_bmp_group:');",
    "  lines.push('    ld b, 4                      ; 4 bytes per group');",
    "  lines.push('ld_bmp_byte:');",
    "  lines.push('    ld a, (hl)');",
    "  lines.push('    ld (de), a');",
    "  lines.push('    inc hl');",
    "  lines.push('    inc de');",
    "  lines.push('    djnz ld_bmp_byte');",
    "  lines.push('    call check_key               ; 1 HALT per 4 bytes');",
    "  lines.push('    dec c');",
    "  lines.push('    jr nz, ld_bmp_group');",
    "  lines.push('');",
    "  lines.push('    exx');",
    "  lines.push('    pop bc                       ; restore B\\'=pline, C\\'=row');",
    "  lines.push('    pop de                       ; restore pixel line address');",
    "  lines.push('    inc d                        ; next pixel line (+$100)');",
    "  lines.push('    dec b');",
    "  lines.push('    exx');",
    "  lines.push('    jr nz, ld_pixel_loop');",
    "  lines.push('');",
    "  lines.push('    ; --- Read 32 attribute bytes in groups of 4 ---');",
    "  lines.push('    exx');",
    "  lines.push('    ld a, c                      ; A = row');",
    "  lines.push('    and $18');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca                          ; (row & $18) >> 3');",
    "  lines.push('    add a, $58');",
    "  lines.push('    ld d, a                      ; D = attr high byte');",
    "  lines.push('    ld a, c');",
    "  lines.push('    and $07');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca                          ; (row % 8) * 32');",
    "  lines.push('    ld e, a                      ; E = attr low byte');",
    "  lines.push('    push de                      ; copy for transfer to main DE');",
    "  lines.push('    exx');",
    "  lines.push('    pop de                       ; DE = attr address');",
    "  lines.push('');",
    "  lines.push('    ld c, 8                      ; 32/4 = 8 groups');",
    "  lines.push('ld_attr_group:');",
    "  lines.push('    ld b, 4                      ; 4 bytes per group');",
    "  lines.push('ld_attr_byte:');",
    "  lines.push('    ld a, (hl)');",
    "  lines.push('    ld (de), a');",
    "  lines.push('    inc hl');",
    "  lines.push('    inc de');",
    "  lines.push('    djnz ld_attr_byte');",
    "  lines.push('    call check_key               ; 1 HALT per 4 bytes');",
    "  lines.push('    dec c');",
    "  lines.push('    jr nz, ld_attr_group');",
    "  lines.push('');",
    "  lines.push('    ; --- Next character row ---');",
    "  lines.push('    exx');",
    "  lines.push('    inc c');",
    "  lines.push('    ld a, c');",
    "  lines.push('    cp 24');",
    "  lines.push('    exx');",
    "  lines.push('    jp nz, ld_row_loop');",
    "  lines.push('');",
    "  lines.push('    ei');",
    "  lines.push('    ret');",
    "  lines.push('');",
    "  var checkKey = generateCheckKeySub();",
    "  for (var i = 0; i < checkKey.length; i++) lines.push(checkKey[i]);",
    "  lines.push('');",
    "  return lines.join('\\n');",
    "}",
    "",
    "function generateCheckerboardDiskInc(blockW, blockH, schemeName) {",
    "  // ULA draws screen every frame, so bytes appear each frame.",
    "  // Write 4 bytes per HALT (≈ tape's ~3.4 bytes/frame).",
    "  // Total HALTs = totalBlocks * blockH * (8 * blockW/4 + blockW/4)",
    "  //            = totalBlocks * blockH * 9 * blockW/4 = 1728 for all schemes",
    "  var bmpGroups = blockW / 4;  // groups of 4 bytes per pixel line",
    "  var table = generateCheckerboardBlockTable(blockW, blockH);",
    "  var totalBlocks = table.length;",
    "  var lines = [];",
    "  lines.push('; ==========================================================');",
    "  lines.push('; disk_' + schemeName + '_loader.inc');",
    "  lines.push('; Checkerboard disk emulator (' + blockW + 'x' + blockH + ' char blocks)');",
    "  lines.push('; ==========================================================');",
    "  lines.push(';');",
    "  lines.push('; Same visual effect as the checkerboard tape loader:');",
    "  lines.push('; even-positioned blocks first, then odd-positioned blocks.');",
    "  lines.push('; Reads from a RAM buffer instead of tape.');",
    "  lines.push(';');",
    "  lines.push('; Press any key during the reveal to show the remaining');",
    "  lines.push('; screen instantly (HALT is patched to NOP via SMC).');",
    "  lines.push(';');",
    "  lines.push('; Register plan:');",
    "  lines.push(';   HL  = source buffer pointer (incremented)');",
    "  lines.push(';   DE  = destination screen address');",
    "  lines.push(';   B   = inner byte counter (4 bytes per group)');",
    "  lines.push(';   C   = group counter (' + bmpGroups + ' groups = ' + blockW + ' bytes)');",
    "  lines.push(\";   HL' = block table pointer\");",
    "  lines.push(\";   C'  = block counter\");",
    "  lines.push(\";   B'  = inner counters\");",
    "  lines.push(\";   D'  = current char row within block\");",
    "  lines.push(\";   E'  = block start column\");",
    "  lines.push('; ==========================================================');",
    "  lines.push('');",
    "  lines.push('disk_entry:');",
    "  lines.push('    di');",
    "  lines.push('    ld hl, screen_data           ; HL = source buffer');",
    "  lines.push('    exx');",
    "  lines.push('    ld hl, block_table           ; HL\\' = table pointer');",
    "  lines.push('    ld c, ' + totalBlocks + '                        ; C\\' = block count');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_block_loop:');",
    "  lines.push('    ; Read (col, row) from table');",
    "  lines.push('    exx');",
    "  lines.push('    ld e, (hl)                   ; E\\' = block start column');",
    "  lines.push('    inc hl');",
    "  lines.push('    ld d, (hl)                   ; D\\' = block start row');",
    "  lines.push('    inc hl');",
    "  lines.push('    push hl                      ; save table pointer');",
    "  lines.push('    push bc                      ; save block counter in C\\'');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('    ; === Bitmap phase: ' + blockH + ' char rows x 8 pixel lines x ' + blockW + ' bytes ===');",
    "  lines.push('    exx');",
    "  lines.push('    ld b, ' + blockH + '                         ; B\\' = char rows in block');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_bmp_crow:');",
    "  lines.push('    ; Compute bitmap address for pixel line 0 of char row D\\'');",
    "  lines.push('    ; High byte = $40 + (row & $18), low byte = (row & 7) * 32 + col');",
    "  lines.push('    exx');",
    "  lines.push('    push de                      ; save D\\'=row, E\\'=col');",
    "  lines.push('    push bc                      ; save B\\'=crow counter');",
    "  lines.push('    ld a, d                      ; A = row');",
    "  lines.push('    and $18');",
    "  lines.push('    add a, $40');",
    "  lines.push('    ld b, a                      ; B = screen high byte (temp)');",
    "  lines.push('    ld a, d');",
    "  lines.push('    and $07');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca                          ; (row % 8) * 32');",
    "  lines.push('    add a, e                     ; + start column');",
    "  lines.push('    ld e, a                      ; E\\' = screen low byte');",
    "  lines.push('    ld d, b                      ; D\\' = screen high byte');",
    "  lines.push('    ld b, 8                      ; B\\' = 8 pixel lines');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_bmp_pline:');",
    "  lines.push('    exx');",
    "  lines.push('    push de                      ; save pixel line address');",
    "  lines.push('    push bc                      ; save B\\'=pline counter');",
    "  lines.push('    push de                      ; copy for transfer to main DE');",
    "  lines.push('    exx');",
    "  lines.push('    pop de                       ; DE = pixel line address');",
    "  lines.push('');",
    "  lines.push('    ; Copy ' + blockW + ' bytes in groups of 4, HALT between each');",
    "  lines.push('    ld c, ' + bmpGroups + '                         ; ' + blockW + '/4 = ' + bmpGroups + ' groups');",
    "  lines.push('ld_bmp_group:');",
    "  lines.push('    ld b, 4                      ; 4 bytes per group');",
    "  lines.push('ld_bmp_byte:');",
    "  lines.push('    ld a, (hl)');",
    "  lines.push('    ld (de), a');",
    "  lines.push('    inc hl');",
    "  lines.push('    inc de');",
    "  lines.push('    djnz ld_bmp_byte');",
    "  lines.push('    call check_key               ; 1 HALT per 4 bytes');",
    "  lines.push('    dec c');",
    "  lines.push('    jr nz, ld_bmp_group');",
    "  lines.push('');",
    "  lines.push('    exx');",
    "  lines.push('    pop bc                       ; restore B\\'=pline counter');",
    "  lines.push('    pop de                       ; restore pixel line address');",
    "  lines.push('    inc d                        ; next pixel line (+$100)');",
    "  lines.push('    dec b');",
    "  lines.push('    exx');",
    "  lines.push('    jr nz, ld_bmp_pline');",
    "  lines.push('');",
    "  lines.push('    exx');",
    "  lines.push('    pop bc                       ; restore B\\'=crow counter');",
    "  lines.push('    pop de                       ; restore D\\'=row, E\\'=col');",
    "  lines.push('    inc d                        ; next char row');",
    "  lines.push('    dec b');",
    "  lines.push('    exx');",
    "  lines.push('    jr nz, ld_bmp_crow');",
    "  lines.push('');",
    "  lines.push('    ; Re-read original (col, row) from block table');",
    "  lines.push('    exx');",
    "  lines.push('    pop bc                       ; restore block counter');",
    "  lines.push('    pop hl                       ; restore table pointer (past this entry)');",
    "  lines.push('    push hl                      ; re-save table pointer');",
    "  lines.push('    push bc                      ; re-save block counter');",
    "  lines.push('    dec hl');",
    "  lines.push('    ld d, (hl)                   ; D\\' = row');",
    "  lines.push('    dec hl');",
    "  lines.push('    ld e, (hl)                   ; E\\' = col');",
    "  lines.push('    ld b, ' + blockH + '                         ; B\\' = char rows for attrs');",
    "  lines.push('    exx');",
    "  lines.push('');",
    "  lines.push('ld_attr_crow:');",
    "  lines.push('    ; Attr address = $5800 + (row & $18)/8*256 + (row & 7)*32 + col');",
    "  lines.push('    exx');",
    "  lines.push('    push de                      ; save D\\'=row, E\\'=col');",
    "  lines.push('    push bc                      ; save B\\'=crow counter');",
    "  lines.push('    ld a, d');",
    "  lines.push('    and $18');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca                          ; (row & $18) >> 3');",
    "  lines.push('    add a, $58');",
    "  lines.push('    ld b, a                      ; B = attr high byte (temp)');",
    "  lines.push('    ld a, d');",
    "  lines.push('    and $07');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca');",
    "  lines.push('    rrca                          ; (row % 8) * 32');",
    "  lines.push('    add a, e                     ; + start column');",
    "  lines.push('    ld e, a');",
    "  lines.push('    ld d, b');",
    "  lines.push('    push de                      ; copy for transfer to main DE');",
    "  lines.push('    exx');",
    "  lines.push('    pop de                       ; DE = attr address');",
    "  lines.push('');",
    "  lines.push('    ; Copy ' + blockW + ' attr bytes in groups of 4');",
    "  lines.push('    ld c, ' + bmpGroups + '                         ; ' + blockW + '/4 = ' + bmpGroups + ' groups');",
    "  lines.push('ld_attr_group:');",
    "  lines.push('    ld b, 4                      ; 4 bytes per group');",
    "  lines.push('ld_attr_byte:');",
    "  lines.push('    ld a, (hl)');",
    "  lines.push('    ld (de), a');",
    "  lines.push('    inc hl');",
    "  lines.push('    inc de');",
    "  lines.push('    djnz ld_attr_byte');",
    "  lines.push('    call check_key               ; 1 HALT per 4 bytes');",
    "  lines.push('    dec c');",
    "  lines.push('    jr nz, ld_attr_group');",
    "  lines.push('');",
    "  lines.push('    exx');",
    "  lines.push('    pop bc                       ; restore B\\'=crow counter');",
    "  lines.push('    pop de                       ; restore D\\'=row, E\\'=col');",
    "  lines.push('    inc d                        ; next char row');",
    "  lines.push('    dec b');",
    "  lines.push('    exx');",
    "  lines.push('    jr nz, ld_attr_crow');",
    "  lines.push('');",
    "  lines.push('    ; --- Next block ---');",
    "  lines.push('    exx');",
    "  lines.push('    pop bc                       ; restore block counter in C\\'');",
    "  lines.push('    pop hl                       ; restore table pointer');",
    "  lines.push('    dec c');",
    "  lines.push('    exx');",
    "  lines.push('    jp nz, ld_block_loop');",
    "  lines.push('');",
    "  lines.push('    ei');",
    "  lines.push('    ret');",
    "  lines.push('');",
    "  var checkKey = generateCheckKeySub();",
    "  for (var i = 0; i < checkKey.length; i++) lines.push(checkKey[i]);",
    "  lines.push('');",
    "  lines.push('; Block table: (col, row) pairs');",
    "  lines.push('block_table:');",
    "  for (var i = 0; i < table.length; i++) {",
    "    lines.push('    db ' + table[i].col + ', ' + table[i].row);",
    "  }",
    "  lines.push('');",
    "  return lines.join('\\n');",
    "}",
    "",
    "function generateDiskAsm(baseName, schemeName, diskIncName) {",
    "  var lines = [",
    "    '; ==========================================================',",
    "    '; Disk Loader Emulator: ' + schemeName + ' scheme',",
    "    '; ==========================================================',",
    "    '; Same visual effect as the tape loader, reads from memory.',",
    "    '; Press any key to show the remaining screen instantly.',",
    "    ';',",
    "    '; Assemble with sjasmplus:',",
    "    ';   sjasmplus ' + baseName + '_disk.asm',",
    "    ';',",
    "    '; The .scr file is the same reordered screen used by the tape',",
    "    '; loader. Both tape and disk ASMs share the same .scr file.',",
    "    '; ==========================================================',",
    "    '',",
    "    '    ORG $8000',",
    "    '',",
    "    '    call disk_entry',",
    "    '    ei',",
    "    'done:',",
    "    '    halt',",
    "    '    jr done                        ; loop forever, picture stays on screen',",
    "    '',",
    "    '    INCLUDE \"' + diskIncName + '\"',",
    "    '',",
    "    'screen_data:',",
    "    '    INCBIN \"' + baseName + '.scr\"',",
    "    ''",
    "  ];",
    "  return lines.join('\\n');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Export dialog UI",
    "// -------------------------------------------------------------------",
    "var tapeExportDialog = null;",
    "var tapeExportData = null;",
    "",
    "function showTapeExportDialog(scrData, baseName) {",
    "  tapeExportData = { scrData: scrData, baseName: baseName };",
    "  if (tapeExportDialog) {",
    "    tapeExportDialog.style.display = '';",
    "    return;",
    "  }",
    "",
    "  // --- Create overlay ---",
    "  var overlay = document.createElement('div');",
    "  overlay.className = 'modal-overlay';",
    "  overlay.style.display = '';",
    "",
    "  var dialog = document.createElement('div');",
    "  dialog.className = 'modal-dialog';",
    "  dialog.style.minWidth = '320px';",
    "",
    "  // --- Title ---",
    "  var title = document.createElement('div');",
    "  title.className = 'modal-title';",
    "  title.textContent = 'Tape Loader Export';",
    "  dialog.appendChild(title);",
    "",
    "  // --- Scheme section ---",
    "  var schemeLabel = document.createElement('div');",
    "  schemeLabel.style.cssText = 'font-size: 12px; font-weight: bold; margin-bottom: 6px;';",
    "  schemeLabel.textContent = 'Loading scheme:';",
    "  dialog.appendChild(schemeLabel);",
    "",
    "  var schemes = [",
    "    { id: 'backward', label: 'Backward ($5AFF \\u2192 $4000)', desc: 'Attrs bottom-up, then bitmap bottom-up' },",
    "    { id: 'linear', label: 'Linear (top \\u2192 bottom)', desc: '8 bitmap lines + attrs per character row' },",
    "    { id: 'checker16x12', label: 'Checkerboard 2\\u00d72', desc: '16x12 char blocks, even first' },",
    "    { id: 'checker8x8', label: 'Checkerboard 4\\u00d73', desc: '8x8 char blocks, even first' },",
    "    { id: 'checker4x4', label: 'Checkerboard 8\\u00d76', desc: '4x4 char blocks, even first' },",
    "    { id: 'turbo', label: 'Turbo Linear (2\\u00d7 speed)', desc: 'TZX turbo, top-to-bottom' }",
    "  ];",
    "",
    "  var schemeGroup = document.createElement('div');",
    "  schemeGroup.style.cssText = 'margin-bottom: 14px; padding-left: 4px;';",
    "  for (var i = 0; i < schemes.length; i++) {",
    "    var sLabel = document.createElement('label');",
    "    sLabel.style.cssText = 'display: flex; align-items: baseline; gap: 6px; font-size: 12px; margin-bottom: 4px; cursor: pointer;';",
    "    var sRadio = document.createElement('input');",
    "    sRadio.type = 'radio';",
    "    sRadio.name = 'tapeScheme';",
    "    sRadio.value = schemes[i].id;",
    "    sRadio.style.margin = '0';",
    "    if (i === 0) sRadio.checked = true;",
    "    var sText = document.createElement('span');",
    "    sText.innerHTML = schemes[i].label + '<span style=\"color: var(--text-secondary); font-size: 11px;\"> \\u2014 ' + schemes[i].desc + '</span>';",
    "    sLabel.appendChild(sRadio);",
    "    sLabel.appendChild(sText);",
    "    schemeGroup.appendChild(sLabel);",
    "  }",
    "  dialog.appendChild(schemeGroup);",
    "",
    "  // --- Format section ---",
    "  var formatLabel = document.createElement('div');",
    "  formatLabel.style.cssText = 'font-size: 12px; font-weight: bold; margin-bottom: 6px;';",
    "  formatLabel.textContent = 'Download format:';",
    "  dialog.appendChild(formatLabel);",
    "",
    "  var stdFormats = [",
    "    { id: 'zip', label: 'ZIP archive (.scr + .asm + .inc)' },",
    "    { id: 'scr', label: 'Screen .scr only' }",
    "  ];",
    "  var turboFormats = [",
    "    { id: 'zip', label: 'ZIP archive (.tzx + .asm + .inc)' },",
    "    { id: 'tzx', label: 'TZX file only' }",
    "  ];",
    "",
    "  var formatGroup = document.createElement('div');",
    "  formatGroup.style.cssText = 'margin-bottom: 16px; padding-left: 4px;';",
    "",
    "  function rebuildFormatRadios(isTurbo) {",
    "    formatGroup.innerHTML = '';",
    "    var formats = isTurbo ? turboFormats : stdFormats;",
    "    for (var i = 0; i < formats.length; i++) {",
    "      var fLabel = document.createElement('label');",
    "      fLabel.style.cssText = 'display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 4px; cursor: pointer;';",
    "      var fRadio = document.createElement('input');",
    "      fRadio.type = 'radio';",
    "      fRadio.name = 'tapeFormat';",
    "      fRadio.value = formats[i].id;",
    "      fRadio.style.margin = '0';",
    "      if (i === 0) fRadio.checked = true;",
    "      var fText = document.createElement('span');",
    "      fText.textContent = formats[i].label;",
    "      fLabel.appendChild(fRadio);",
    "      fLabel.appendChild(fText);",
    "      formatGroup.appendChild(fLabel);",
    "    }",
    "  }",
    "  rebuildFormatRadios(false);",
    "  dialog.appendChild(formatGroup);",
    "",
    "  // --- Disk emulator checkbox ---",
    "  var diskRow = document.createElement('div');",
    "  diskRow.style.cssText = 'margin-bottom: 14px; padding-left: 4px;';",
    "  var diskLabel = document.createElement('label');",
    "  diskLabel.style.cssText = 'display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer;';",
    "  var diskCheckbox = document.createElement('input');",
    "  diskCheckbox.type = 'checkbox';",
    "  diskCheckbox.id = 'tapeDiskEmulator';",
    "  diskCheckbox.style.margin = '0';",
    "  var diskText = document.createElement('span');",
    "  diskText.textContent = 'Include disk emulator ASM';",
    "  diskLabel.appendChild(diskCheckbox);",
    "  diskLabel.appendChild(diskText);",
    "  diskRow.appendChild(diskLabel);",
    "  dialog.appendChild(diskRow);",
    "",
    "  function updateDiskCheckboxVisibility() {",
    "    var sel = schemeGroup.querySelector('input[name=\"tapeScheme\"]:checked');",
    "    var fmt = formatGroup.querySelector('input[name=\"tapeFormat\"]:checked');",
    "    var isTurbo = sel && sel.value === 'turbo';",
    "    var isZip = fmt && fmt.value === 'zip';",
    "    if (isTurbo || !isZip) {",
    "      diskRow.style.display = 'none';",
    "      diskCheckbox.checked = false;",
    "    } else {",
    "      diskRow.style.display = '';",
    "    }",
    "  }",
    "  updateDiskCheckboxVisibility();",
    "",
    "  // --- Update format radios when scheme changes ---",
    "  schemeGroup.addEventListener('change', function() {",
    "    var sel = overlay.querySelector('input[name=\"tapeScheme\"]:checked');",
    "    rebuildFormatRadios(sel && sel.value === 'turbo');",
    "    updateDiskCheckboxVisibility();",
    "  });",
    "  formatGroup.addEventListener('change', function() {",
    "    updateDiskCheckboxVisibility();",
    "  });",
    "",
    "  // --- Buttons ---",
    "  var btnRow = document.createElement('div');",
    "  btnRow.style.cssText = 'display: flex; gap: 8px; justify-content: flex-end;';",
    "",
    "  var cancelBtn = document.createElement('button');",
    "  cancelBtn.textContent = 'Cancel';",
    "  cancelBtn.style.cssText = 'padding: 4px 16px; font-size: 12px;';",
    "",
    "  var exportBtn = document.createElement('button');",
    "  exportBtn.textContent = 'Export';",
    "  exportBtn.style.cssText = 'padding: 4px 16px; font-size: 12px;';",
    "",
    "  btnRow.appendChild(cancelBtn);",
    "  btnRow.appendChild(exportBtn);",
    "  dialog.appendChild(btnRow);",
    "",
    "  overlay.appendChild(dialog);",
    "  document.body.appendChild(overlay);",
    "  tapeExportDialog = overlay;",
    "",
    "  // --- Event handlers ---",
    "  function closeDialog() {",
    "    overlay.style.display = 'none';",
    "  }",
    "",
    "  cancelBtn.addEventListener('click', closeDialog);",
    "  overlay.addEventListener('click', function(e) {",
    "    if (e.target === overlay) closeDialog();",
    "  });",
    "  document.addEventListener('keydown', function onKey(e) {",
    "    if (overlay.style.display === 'none') return;",
    "    if (e.key === 'Escape') { closeDialog(); e.preventDefault(); }",
    "  });",
    "",
    "  exportBtn.addEventListener('click', function() {",
    "    var schemeRadio = overlay.querySelector('input[name=\"tapeScheme\"]:checked');",
    "    var formatRadio = overlay.querySelector('input[name=\"tapeFormat\"]:checked');",
    "    var scheme = schemeRadio ? schemeRadio.value : 'backward';",
    "    var format = formatRadio ? formatRadio.value : 'zip';",
    "    closeDialog();",
    "    if (tapeExportData) doExport(tapeExportData.scrData, tapeExportData.baseName, scheme, format, diskCheckbox.checked);",
    "  });",
    "}",
    "",
    "function doExport(scrData, baseName, scheme, format, includeDisk) {",
    "  var transformed;",
    "  var asmSource;",
    "  var schemeName;",
    "",
    "  var checkerSchemes = {",
    "    checker16x12: { blockW: 16, blockH: 12, name: 'checker16x12', inc: 'checker16x12_loader.inc' },",
    "    checker8x8:   { blockW: 8,  blockH: 8,  name: 'checker8x8',   inc: 'checker8x8_loader.inc' },",
    "    checker4x4:   { blockW: 4,  blockH: 4,  name: 'checker4x4',   inc: 'checker4x4_loader.inc' }",
    "  };",
    "",
    "  // --- Turbo scheme: TZX export ---",
    "  if (scheme === 'turbo') {",
    "    var tzxData = buildTzxFile(scrData);",
    "    if (format === 'tzx') {",
    "      downloadFile(tzxData, baseName + '_turbo.tzx', 'application/octet-stream');",
    "    } else {",
    "      var tAsmSource = generateTurboAsm(baseName);",
    "      var tIncSource = generateTurboLoaderInc();",
    "      var zip = createZip([",
    "        { name: baseName + '.tzx', data: tzxData },",
    "        { name: baseName + '.asm', data: new TextEncoder().encode(tAsmSource) },",
    "        { name: 'turbo_loader.inc', data: new TextEncoder().encode(tIncSource) }",
    "      ]);",
    "      downloadFile(zip, baseName + '_turbo.zip', 'application/zip');",
    "    }",
    "    return;",
    "  }",
    "",
    "  // --- Standard schemes: SCR/ZIP export ---",
    "  if (scheme === 'backward') {",
    "    transformed = reverseScreen(scrData);",
    "    asmSource = generateBackwardAsm(baseName);",
    "    schemeName = 'backward';",
    "  } else if (scheme === 'linear') {",
    "    transformed = linearScreen(scrData);",
    "    asmSource = generateLinearAsm(baseName);",
    "    schemeName = 'linear';",
    "  } else if (checkerSchemes[scheme]) {",
    "    var cs = checkerSchemes[scheme];",
    "    transformed = checkerboardScreen(scrData, cs.blockW, cs.blockH);",
    "    asmSource = generateCheckerboardAsm(baseName, cs.blockW, cs.blockH, cs.name, cs.inc);",
    "    schemeName = cs.name;",
    "  } else {",
    "    alert('Unknown scheme: ' + scheme);",
    "    return;",
    "  }",
    "",
    "  if (format === 'scr') {",
    "    downloadFile(transformed, baseName + '_' + schemeName + '.scr', 'application/octet-stream');",
    "  } else {",
    "    var incName, incSource;",
    "    if (scheme === 'backward') {",
    "      incName = 'backward_loader.inc';",
    "      incSource = generateBackwardLoaderInc();",
    "    } else if (scheme === 'linear') {",
    "      incName = 'linear_loader.inc';",
    "      incSource = generateLinearLoaderInc();",
    "    } else if (checkerSchemes[scheme]) {",
    "      var cs2 = checkerSchemes[scheme];",
    "      incName = cs2.inc;",
    "      incSource = generateCheckerboardLoaderInc(cs2.blockW, cs2.blockH, cs2.name);",
    "    }",
    "    var zipFiles = [",
    "      { name: baseName + '.scr', data: transformed },",
    "      { name: baseName + '.asm', data: new TextEncoder().encode(asmSource) },",
    "      { name: incName, data: new TextEncoder().encode(incSource) }",
    "    ];",
    "    if (includeDisk) {",
    "      var diskIncName, diskIncSource;",
    "      if (scheme === 'backward') {",
    "        diskIncName = 'disk_backward_loader.inc';",
    "        diskIncSource = generateBackwardDiskInc();",
    "      } else if (scheme === 'linear') {",
    "        diskIncName = 'disk_linear_loader.inc';",
    "        diskIncSource = generateLinearDiskInc();",
    "      } else if (checkerSchemes[scheme]) {",
    "        var csd = checkerSchemes[scheme];",
    "        diskIncName = 'disk_' + csd.name + '_loader.inc';",
    "        diskIncSource = generateCheckerboardDiskInc(csd.blockW, csd.blockH, csd.name);",
    "      }",
    "      var diskAsmSource = generateDiskAsm(baseName, schemeName, diskIncName);",
    "      zipFiles.push({ name: diskIncName, data: new TextEncoder().encode(diskIncSource) });",
    "      zipFiles.push({ name: baseName + '_disk.asm', data: new TextEncoder().encode(diskAsmSource) });",
    "    }",
    "    var zip = createZip(zipFiles);",
    "    downloadFile(zip, baseName + '_' + schemeName + '.zip', 'application/zip');",
    "  }",
    "}",
    "",
    "// ===================================================================",
    "// Plugin definition",
    "// ===================================================================",
    "plugin = {",
    "",
    "  // -----------------------------------------------------------------",
    "  // Extract: pass-through for .scr files",
    "  // -----------------------------------------------------------------",
    "  extract: function(fileBytes) {",
    "    if (fileBytes.length < 6912) {",
    "      return [{ name: 'Screen', format: 'scr', data: new Uint8Array(6912) }];",
    "    }",
    "    return [{ name: 'Screen', format: 'scr', data: fileBytes.slice(0, 6912) }];",
    "  },",
    "",
    "  // -----------------------------------------------------------------",
    "  // Patch/Export: show scheme dialog, transform, download",
    "  // -----------------------------------------------------------------",
    "  patch: function(originalBytes, pictures) {",
    "    if (!pictures.length || !pictures[0].data || pictures[0].data.length < 6912) {",
    "      alert('No valid SCR data to export.');",
    "      return null;",
    "    }",
    "",
    "    var scrData = pictures[0].data.slice(0, 6912);",
    "    var baseName = (pictures[0].name || 'screen').replace(/\\.[^.]+$/, '').replace(/[^a-zA-Z0-9_-]/g, '_').replace(/^_+|_+$/g, '').replace(/_+/g, '_') || 'screen';",
    "",
    "    showTapeExportDialog(scrData, baseName);",
    "    return null;",
    "  }",
    "",
    "};"
  ]
}
