{
  "_doc": [
    "SpectraLab RLE Plugin",
    "",
    "Loads and saves RLE-compressed ZX Spectrum screen files.",
    "",
    "Compression format:",
    "  - Byte 0x00 or 0xFF: followed by a run-length count byte.",
    "    Emit that many copies of the value (0x00 or 0xFF).",
    "  - Any other byte: literal value, written as-is.",
    "",
    "Decompressed output is always a standard 6912-byte .scr",
    "(6144 bitmap + 768 attributes)."
  ],

  "id": "rle_scr",
  "name": "RLE Compressed SCR",
  "version": 1,
  "description": "Load/save RLE-packed ZX Spectrum screen files (0x00/0xFF + count)",
  "fileExtensions": [".rle", ".bin"],
  "type": "js",

  "jsSource": [
    "plugin = {",
    "",
    "  // ---------------------------------------------------------------",
    "  // Decompress RLE → 6912-byte SCR",
    "  // ---------------------------------------------------------------",
    "  extract: function(fileBytes) {",
    "    var SCR_SIZE = 6912;",
    "    var out = new Uint8Array(SCR_SIZE);",
    "    var src = 0;",
    "    var dst = 0;",
    "",
    "    while (src < fileBytes.length && dst < SCR_SIZE) {",
    "      var b = fileBytes[src++];",
    "",
    "      if (b === 0x00 || b === 0xFF) {",
    "        // Run-length: next byte is the repeat count",
    "        if (src >= fileBytes.length) break;",
    "        var count = fileBytes[src++];",
    "        var end = Math.min(dst + count, SCR_SIZE);",
    "        while (dst < end) {",
    "          out[dst++] = b;",
    "        }",
    "      } else {",
    "        // Literal byte",
    "        out[dst++] = b;",
    "      }",
    "    }",
    "",
    "    if (dst < SCR_SIZE) {",
    "      // Warn but still return what we got",
    "      // (short files are padded with zeros by default)",
    "    }",
    "",
    "    return [{",
    "      name:   'Screen',",
    "      format: 'scr',",
    "      data:   out",
    "    }];",
    "  },",
    "",
    "  // ---------------------------------------------------------------",
    "  // Compress 6912-byte SCR → RLE",
    "  // ---------------------------------------------------------------",
    "  patch: function(originalBytes, pictures) {",
    "    if (!pictures.length || !pictures[0].data.length) {",
    "      return originalBytes;",
    "    }",
    "",
    "    var data = pictures[0].data;",
    "    var buf = [];",
    "    var pos = 0;",
    "",
    "    while (pos < data.length) {",
    "      var b = data[pos];",
    "",
    "      if (b === 0x00 || b === 0xFF) {",
    "        // Count consecutive identical bytes (max 255)",
    "        var count = 0;",
    "        while (pos < data.length && data[pos] === b && count < 255) {",
    "          count++;",
    "          pos++;",
    "        }",
    "        buf.push(b, count);",
    "      } else {",
    "        // Literal byte",
    "        buf.push(b);",
    "        pos++;",
    "      }",
    "    }",
    "",
    "    return new Uint8Array(buf);",
    "  }",
    "",
    "};"
  ]
}
