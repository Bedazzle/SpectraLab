{
  "_doc": [
    "SpectraLab SCA Diff Analyzer Plugin",
    "",
    "Opens Type 0 SCA animations and produces a ZIP with frame-to-frame",
    "diff analysis. For each consecutive frame pair, if the number of",
    "changed cells is within a user-defined threshold, the frame is",
    "exported as cell-level diffs (coordinates + data as defb in .asm).",
    "Otherwise, the full frame is exported as a binary .bin file with",
    "incbin in the .asm.",
    "",
    "User flow:",
    "  1. Open .slpluginjs via browse or drag-and-drop",
    "  2. Open a .sca file with the plugin",
    "  3. Frame 0 is shown in the viewer as a regular SCR",
    "  4. Click Export -> plugin shows a dialog with:",
    "     - Diff unit: Bitmap+attribute (9 bytes/cell) or Attribute only (1 byte/cell)",
    "     - Threshold: max changed cells count (if more cells differ -> full frame binary)",
    "     - Statistics preview with live updates",
    "  5. Click Export -> downloads a .zip",
    "",
    "ZIP output:",
    "  animation_diff/",
    "    animation.asm        Main ASM with frame data, delay table, summary",
    "    frame_000.bin        Frame 0 — always full binary (6912 bytes)",
    "    frame_NNN.bin        Full binary frames (when diff > threshold)"
  ],

  "id": "sca_diff_analyzer",
  "name": "SCA Animation Diff Analyzer",
  "version": 1,
  "description": "Analyze SCA Type 0 animations and export frame-to-frame diffs as ASM + binary ZIP",
  "fileExtensions": [".sca"],
  "type": "js",

  "jsSource": [
    "// ===================================================================",
    "// SCA Animation Diff Analyzer plugin",
    "// ===================================================================",
    "",
    "// -------------------------------------------------------------------",
    "// CRC32 + ZIP utilities (store method, no compression)",
    "// -------------------------------------------------------------------",
    "var crc32Table = null;",
    "",
    "function crc32(data) {",
    "  if (!crc32Table) {",
    "    crc32Table = new Uint32Array(256);",
    "    for (var i = 0; i < 256; i++) {",
    "      var c = i;",
    "      for (var j = 0; j < 8; j++) {",
    "        c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);",
    "      }",
    "      crc32Table[i] = c;",
    "    }",
    "  }",
    "  var crc = 0xFFFFFFFF;",
    "  for (var i = 0; i < data.length; i++) {",
    "    crc = crc32Table[(crc ^ data[i]) & 0xFF] ^ (crc >>> 8);",
    "  }",
    "  return (crc ^ 0xFFFFFFFF) >>> 0;",
    "}",
    "",
    "function createZip(files) {",
    "  var localHeaders = [];",
    "  var centralHeaders = [];",
    "  var offset = 0;",
    "",
    "  for (var f = 0; f < files.length; f++) {",
    "    var nameBytes = new TextEncoder().encode(files[f].name);",
    "    var data = files[f].data;",
    "    var crc = crc32(data);",
    "",
    "    var localHeader = new Uint8Array(30 + nameBytes.length);",
    "    var lv = new DataView(localHeader.buffer);",
    "    lv.setUint32(0, 0x04034b50, true);",
    "    lv.setUint16(4, 20, true);",
    "    lv.setUint16(6, 0, true);",
    "    lv.setUint16(8, 0, true);",
    "    lv.setUint16(10, 0, true);",
    "    lv.setUint16(12, 0, true);",
    "    lv.setUint32(14, crc, true);",
    "    lv.setUint32(18, data.length, true);",
    "    lv.setUint32(22, data.length, true);",
    "    lv.setUint16(26, nameBytes.length, true);",
    "    lv.setUint16(28, 0, true);",
    "    localHeader.set(nameBytes, 30);",
    "",
    "    var centralHeader = new Uint8Array(46 + nameBytes.length);",
    "    var cv = new DataView(centralHeader.buffer);",
    "    cv.setUint32(0, 0x02014b50, true);",
    "    cv.setUint16(4, 20, true);",
    "    cv.setUint16(6, 20, true);",
    "    cv.setUint16(8, 0, true);",
    "    cv.setUint16(10, 0, true);",
    "    cv.setUint16(12, 0, true);",
    "    cv.setUint16(14, 0, true);",
    "    cv.setUint32(16, crc, true);",
    "    cv.setUint32(20, data.length, true);",
    "    cv.setUint32(24, data.length, true);",
    "    cv.setUint16(28, nameBytes.length, true);",
    "    cv.setUint16(30, 0, true);",
    "    cv.setUint16(32, 0, true);",
    "    cv.setUint16(34, 0, true);",
    "    cv.setUint16(36, 0, true);",
    "    cv.setUint32(38, 0, true);",
    "    cv.setUint32(42, offset, true);",
    "    centralHeader.set(nameBytes, 46);",
    "",
    "    localHeaders.push({ header: localHeader, data: data });",
    "    centralHeaders.push(centralHeader);",
    "    offset += localHeader.length + data.length;",
    "  }",
    "",
    "  var centralDirOffset = offset;",
    "  var centralDirSize = 0;",
    "  for (var i = 0; i < centralHeaders.length; i++) {",
    "    centralDirSize += centralHeaders[i].length;",
    "  }",
    "",
    "  var endRecord = new Uint8Array(22);",
    "  var ev = new DataView(endRecord.buffer);",
    "  ev.setUint32(0, 0x06054b50, true);",
    "  ev.setUint16(4, 0, true);",
    "  ev.setUint16(6, 0, true);",
    "  ev.setUint16(8, files.length, true);",
    "  ev.setUint16(10, files.length, true);",
    "  ev.setUint32(12, centralDirSize, true);",
    "  ev.setUint32(16, centralDirOffset, true);",
    "  ev.setUint16(20, 0, true);",
    "",
    "  var totalSize = offset + centralDirSize + 22;",
    "  var result = new Uint8Array(totalSize);",
    "  var pos = 0;",
    "  for (var i = 0; i < localHeaders.length; i++) {",
    "    result.set(localHeaders[i].header, pos);",
    "    pos += localHeaders[i].header.length;",
    "    result.set(localHeaders[i].data, pos);",
    "    pos += localHeaders[i].data.length;",
    "  }",
    "  for (var i = 0; i < centralHeaders.length; i++) {",
    "    result.set(centralHeaders[i], pos);",
    "    pos += centralHeaders[i].length;",
    "  }",
    "  result.set(endRecord, pos);",
    "  return result;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// SCA Type 0 parser",
    "// -------------------------------------------------------------------",
    "",
    "function parseScaType0(fileBytes) {",
    "  if (fileBytes.length < 14) return null;",
    "",
    "  var sig = String.fromCharCode(fileBytes[0], fileBytes[1], fileBytes[2]);",
    "  if (sig !== 'SCA') return null;",
    "",
    "  var frameCount = fileBytes[9] | (fileBytes[10] << 8);",
    "  var payloadType = fileBytes[11];",
    "",
    "  if (payloadType !== 0) return null;",
    "  if (frameCount < 2) return null;",
    "",
    "  var payloadOffset = fileBytes[12] | (fileBytes[13] << 8);",
    "  var delays = [];",
    "  for (var i = 0; i < frameCount; i++) {",
    "    delays.push(fileBytes[payloadOffset + i]);",
    "  }",
    "",
    "  var frameDataStart = payloadOffset + frameCount;",
    "  var frameSize = 6912;",
    "  var frames = [];",
    "",
    "  for (var i = 0; i < frameCount; i++) {",
    "    var off = frameDataStart + i * frameSize;",
    "    if (off + frameSize > fileBytes.length) break;",
    "    frames.push(fileBytes.slice(off, off + frameSize));",
    "  }",
    "",
    "  if (frames.length < 2) return null;",
    "",
    "  return { frames: frames, delays: delays };",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Cell diff engine",
    "// -------------------------------------------------------------------",
    "",
    "// Get the SCR address for a bitmap byte within a cell",
    "// charRow: 0-23, charCol: 0-31, scanLine: 0-7 within the cell",
    "function scrBitmapAddr(charRow, charCol, scanLine) {",
    "  var third = Math.floor(charRow / 8);",
    "  var cellRow = charRow % 8;",
    "  return third * 2048 + scanLine * 256 + cellRow * 32 + charCol;",
    "}",
    "",
    "// Get the attribute address for a cell",
    "function scrAttrAddr(charRow, charCol) {",
    "  return 6144 + charRow * 32 + charCol;",
    "}",
    "",
    "// Compare two frames in bitmap+attr mode (9 bytes per cell)",
    "// Returns array of { row, col, bitmap: Uint8Array(8), attr }",
    "function diffFramesBitmapAttr(frame1, frame2) {",
    "  var diffs = [];",
    "  for (var row = 0; row < 24; row++) {",
    "    for (var col = 0; col < 32; col++) {",
    "      var changed = false;",
    "      // Check attribute",
    "      var attrAddr = scrAttrAddr(row, col);",
    "      if (frame1[attrAddr] !== frame2[attrAddr]) {",
    "        changed = true;",
    "      }",
    "      // Check 8 bitmap bytes",
    "      if (!changed) {",
    "        for (var s = 0; s < 8; s++) {",
    "          var addr = scrBitmapAddr(row, col, s);",
    "          if (frame1[addr] !== frame2[addr]) {",
    "            changed = true;",
    "            break;",
    "          }",
    "        }",
    "      }",
    "      if (changed) {",
    "        var bitmap = new Uint8Array(8);",
    "        for (var s = 0; s < 8; s++) {",
    "          bitmap[s] = frame2[scrBitmapAddr(row, col, s)];",
    "        }",
    "        diffs.push({ row: row, col: col, bitmap: bitmap, attr: frame2[attrAddr] });",
    "      }",
    "    }",
    "  }",
    "  return diffs;",
    "}",
    "",
    "// Compare two frames in attribute-only mode (1 byte per cell)",
    "// Returns array of { row, col, attr }",
    "function diffFramesAttrOnly(frame1, frame2) {",
    "  var diffs = [];",
    "  for (var row = 0; row < 24; row++) {",
    "    for (var col = 0; col < 32; col++) {",
    "      var attrAddr = scrAttrAddr(row, col);",
    "      if (frame1[attrAddr] !== frame2[attrAddr]) {",
    "        diffs.push({ row: row, col: col, attr: frame2[attrAddr] });",
    "      }",
    "    }",
    "  }",
    "  return diffs;",
    "}",
    "",
    "",
    "// -------------------------------------------------------------------",
    "// Hex formatting helpers",
    "// -------------------------------------------------------------------",
    "function hexByte(b) {",
    "  return '#' + ('00' + b.toString(16)).slice(-2);",
    "}",
    "",
    "function padNum(n, w) {",
    "  var s = '' + n;",
    "  while (s.length < w) s = ' ' + s;",
    "  return s;",
    "}",
    "",
    "function padStart(s, w) {",
    "  while (s.length < w) s = '0' + s;",
    "  return s;",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// ASM generator",
    "// -------------------------------------------------------------------",
    "function generateAsm(frames, delays, threshold, attrOnly, fileName) {",
    "  var diffFunc = attrOnly ? diffFramesAttrOnly : diffFramesBitmapAttr;",
    "  var bytesPerCell = attrOnly ? 3 : 11;",
    "  var unitLabel = attrOnly ? 'attr' : 'bitmap+attr';",
    "",
    "  // Pre-compute all diffs",
    "  var frameDiffs = [null];",
    "  for (var i = 1; i < frames.length; i++) {",
    "    frameDiffs.push(diffFunc(frames[i - 1], frames[i]));",
    "  }",
    "",
    "  // Classify frames",
    "  var frameTypes = ['full'];",
    "  var diffCount = 0;",
    "  var fullCount = 1;",
    "  for (var i = 1; i < frames.length; i++) {",
    "    if (frameDiffs[i].length <= threshold) {",
    "      frameTypes.push('diff');",
    "      diffCount++;",
    "    } else {",
    "      frameTypes.push('full');",
    "      fullCount++;",
    "    }",
    "  }",
    "",
    "  var lines = [];",
    "  lines.push('; SCA Diff Analysis \\u2014 ' + fileName);",
    "  lines.push('; Generated by SpectraLab v' + (typeof APP_VERSION !== 'undefined' ? APP_VERSION : '2.34'));",
    "  lines.push('; Frames: ' + frames.length + ', Threshold: ' + threshold + ' cells, Diff unit: ' + unitLabel);",
    "  lines.push('; Diff frames: ' + diffCount + ', Full frames: ' + fullCount);",
    "  lines.push('');",
    "",
    "  // Build ZIP files list (will be filled by caller)",
    "  var binFiles = [];",
    "",
    "  for (var i = 0; i < frames.length; i++) {",
    "    var label = 'Frame_' + padStart('' + i, 3);",
    "    var binName = 'frame_' + padStart('' + i, 3) + '.bin';",
    "",
    "    if (frameTypes[i] === 'full') {",
    "      if (i === 0) {",
    "        lines.push('; Frame ' + i + ' \\u2014 full (always)');",
    "      } else {",
    "        lines.push('; Frame ' + i + ' \\u2014 full (diff=' + frameDiffs[i].length + ' cells > threshold)');",
    "      }",
    "      lines.push(label + ':');",
    "      lines.push('    INCBIN \"' + binName + '\"      ; 6912 bytes');",
    "      lines.push('');",
    "      binFiles.push({ name: binName, data: frames[i] });",
    "    } else {",
    "      var diffs = frameDiffs[i];",
    "      lines.push('; Frame ' + i + ' \\u2014 diff from frame ' + (i - 1) + ' (' + diffs.length + ' cells changed)');",
    "      lines.push(label + ':');",
    "      lines.push('    DB ' + diffs.length + '                       ; number of changed cells');",
    "",
    "      for (var d = 0; d < diffs.length; d++) {",
    "        var cell = diffs[d];",
    "        lines.push('    DB ' + cell.row + ',' + cell.col);",
    "        if (!attrOnly) {",
    "          var bmpHex = [];",
    "          for (var b = 0; b < 8; b++) {",
    "            bmpHex.push(hexByte(cell.bitmap[b]));",
    "          }",
    "          lines.push('    DB ' + bmpHex.join(','));",
    "        }",
    "        lines.push('    DB ' + hexByte(cell.attr));",
    "      }",
    "      lines.push('');",
    "    }",
    "  }",
    "",
    "  // Delay table",
    "  lines.push('; === Delay table ===');",
    "  lines.push('DelayTable:');",
    "  var delayParts = [];",
    "  for (var i = 0; i < frames.length; i++) {",
    "    delayParts.push('' + (delays[i] || 2));",
    "  }",
    "  // Emit in rows of 16",
    "  for (var i = 0; i < delayParts.length; i += 16) {",
    "    var chunk = delayParts.slice(i, i + 16);",
    "    lines.push('    DB ' + chunk.join(','));",
    "  }",
    "  lines.push('');",
    "",
    "  // Summary",
    "  lines.push('; === Summary ===');",
    "  var totalFullBytes = 0;",
    "  var totalDiffCells = 0;",
    "  var diffFrameCount = 0;",
    "  for (var i = 0; i < frames.length; i++) {",
    "    if (frameTypes[i] === 'full') {",
    "      var sz = 6912;",
    "      totalFullBytes += sz;",
    "      lines.push('; Frame ' + padNum(i, 3) + ': FULL   ' + sz + ' bytes');",
    "    } else {",
    "      var nc = frameDiffs[i].length;",
    "      var sz = 1 + nc * bytesPerCell;",
    "      totalDiffCells += nc;",
    "      diffFrameCount++;",
    "      lines.push('; Frame ' + padNum(i, 3) + ': DIFF ' + padNum(nc, 5) + ' cells (' + padNum(sz, 5) + ' bytes)');",
    "    }",
    "  }",
    "  var avgCells = diffFrameCount > 0 ? Math.round(totalDiffCells / diffFrameCount) : 0;",
    "  lines.push('; Total: ' + fullCount + ' full frames (' + totalFullBytes + ' bytes) + ' + diffCount + ' diff frames (avg ' + avgCells + ' cells)');",
    "  lines.push('');",
    "",
    "  return { asmText: lines.join('\\n'), binFiles: binFiles };",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Dialog UI",
    "// -------------------------------------------------------------------",
    "function showDiffDialog(frames, delays, fileName) {",
    "",
    "  var overlay = document.createElement('div');",
    "  overlay.className = 'modal-overlay';",
    "",
    "  var dialog = document.createElement('div');",
    "  dialog.className = 'modal-dialog';",
    "  dialog.style.minWidth = '420px';",
    "",
    "  // Title",
    "  var title = document.createElement('div');",
    "  title.className = 'modal-title';",
    "  title.textContent = 'SCA Diff Analyzer';",
    "  dialog.appendChild(title);",
    "",
    "  // Info line",
    "  var infoDiv = document.createElement('div');",
    "  infoDiv.style.cssText = 'font-size: 11px; color: var(--text-secondary); margin-bottom: 10px;';",
    "  infoDiv.textContent = fileName + ' \\u2014 ' + frames.length + ' frames (Type 0)';",
    "  dialog.appendChild(infoDiv);",
    "",
    "  // --- Diff unit section ---",
    "  var unitLabel = document.createElement('div');",
    "  unitLabel.style.cssText = 'font-size: 12px; font-weight: bold; margin-bottom: 6px;';",
    "  unitLabel.textContent = 'Diff unit:';",
    "  dialog.appendChild(unitLabel);",
    "",
    "  var units = [",
    "    { id: 'bitmapattr', label: 'Bitmap + attribute (9 bytes/cell)' },",
    "    { id: 'attronly', label: 'Attribute only (1 byte/cell)' }",
    "  ];",
    "",
    "  var unitGroup = document.createElement('div');",
    "  unitGroup.style.cssText = 'margin-bottom: 14px; padding-left: 4px;';",
    "  for (var i = 0; i < units.length; i++) {",
    "    var uLabel = document.createElement('label');",
    "    uLabel.style.cssText = 'display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 4px; cursor: pointer;';",
    "    var uRadio = document.createElement('input');",
    "    uRadio.type = 'radio';",
    "    uRadio.name = 'diffUnit';",
    "    uRadio.value = units[i].id;",
    "    uRadio.style.margin = '0';",
    "    if (i === 0) uRadio.checked = true;",
    "    var uText = document.createElement('span');",
    "    uText.textContent = units[i].label;",
    "    uLabel.appendChild(uRadio);",
    "    uLabel.appendChild(uText);",
    "    unitGroup.appendChild(uLabel);",
    "  }",
    "  dialog.appendChild(unitGroup);",
    "",
    "  // --- Threshold section ---",
    "  var threshLabel = document.createElement('div');",
    "  threshLabel.style.cssText = 'font-size: 12px; font-weight: bold; margin-bottom: 6px;';",
    "  threshLabel.textContent = 'Threshold (max changed cells for diff):';",
    "  dialog.appendChild(threshLabel);",
    "",
    "  var threshRow = document.createElement('div');",
    "  threshRow.style.cssText = 'display: flex; align-items: center; gap: 8px; margin-bottom: 14px; padding-left: 4px;';",
    "",
    "  var threshInput = document.createElement('input');",
    "  threshInput.type = 'number';",
    "  threshInput.min = '1';",
    "  threshInput.max = '768';",
    "  threshInput.value = '48';",
    "  threshInput.style.cssText = 'width: 70px; font-size: 12px; padding: 2px 4px;';",
    "",
    "  var threshHint = document.createElement('span');",
    "  threshHint.style.cssText = 'font-size: 11px; color: var(--text-secondary);';",
    "  threshHint.textContent = '(1\\u2013768 cells)';",
    "",
    "  threshRow.appendChild(threshInput);",
    "  threshRow.appendChild(threshHint);",
    "  dialog.appendChild(threshRow);",
    "",
    "  // --- Stats display ---",
    "  var statsDiv = document.createElement('div');",
    "  statsDiv.style.cssText = 'font-size: 11px; background: var(--bg-secondary, #1a1a2e); border: 1px solid var(--border-color, #333); border-radius: 4px; padding: 8px 10px; margin-bottom: 14px; line-height: 1.6; font-family: monospace;';",
    "  dialog.appendChild(statsDiv);",
    "",
    "  // --- Per-frame detail list ---",
    "  var detailLabel = document.createElement('div');",
    "  detailLabel.style.cssText = 'font-size: 11px; color: var(--text-secondary); margin-bottom: 4px;';",
    "  detailLabel.textContent = 'Per-frame detail (' + (frames.length - 1) + ' transitions):';",
    "  dialog.appendChild(detailLabel);",
    "",
    "  var detailList = document.createElement('div');",
    "  detailList.style.cssText = 'font-size: 10px; font-family: monospace; background: var(--bg-secondary, #1a1a2e); border: 1px solid var(--border-color, #333); border-radius: 4px; padding: 4px 6px; margin-bottom: 14px; max-height: 120px; overflow-y: auto; line-height: 1.5;';",
    "  dialog.appendChild(detailList);",
    "",
    "  // Pre-compute diffs for both modes",
    "  var bitmapDiffCounts = [];",
    "  var attrDiffCounts = [];",
    "  for (var i = 1; i < frames.length; i++) {",
    "    bitmapDiffCounts.push(diffFramesBitmapAttr(frames[i - 1], frames[i]).length);",
    "    attrDiffCounts.push(diffFramesAttrOnly(frames[i - 1], frames[i]).length);",
    "  }",
    "",
    "  function updateStats() {",
    "    var unitRadio = overlay.querySelector('input[name=\"diffUnit\"]:checked');",
    "    var attrOnly = unitRadio && unitRadio.value === 'attronly';",
    "    var threshold = parseInt(threshInput.value, 10) || 48;",
    "    if (threshold < 1) threshold = 1;",
    "    if (threshold > 768) threshold = 768;",
    "",
    "    var counts = attrOnly ? attrDiffCounts : bitmapDiffCounts;",
    "    var bytesPerCell = attrOnly ? 3 : 11;",
    "    var diffFrames = 0;",
    "    var fullFrames = 1;",
    "    var diffTotalBytes = 0;",
    "    var fullTotalBytes = 6912;",
    "",
    "    for (var i = 0; i < counts.length; i++) {",
    "      if (counts[i] <= threshold) {",
    "        diffFrames++;",
    "        diffTotalBytes += 1 + counts[i] * bytesPerCell;",
    "      } else {",
    "        fullFrames++;",
    "        fullTotalBytes += 6912;",
    "      }",
    "    }",
    "",
    "    var total = diffTotalBytes + fullTotalBytes;",
    "    var totalFrames = frames.length;",
    "    var transitions = counts.length;",
    "",
    "    statsDiv.innerHTML = ",
    "      totalFrames + ' frames: 1 base + ' +",
    "      '<span style=\"color:#4a9\">' + diffFrames + ' diff</span> + ' +",
    "      '<span style=\"color:#c55\">' + (fullFrames - 1) + ' full</span>' +",
    "      ' (of ' + transitions + ' transitions)<br>' +",
    "      'Size: ' + (total / 1024).toFixed(1) + ' KB total' +",
    "      ' (' + (diffTotalBytes / 1024).toFixed(1) + ' KB diff + ' +",
    "      (fullTotalBytes / 1024).toFixed(1) + ' KB full)';",
    "",
    "    // Update per-frame detail list",
    "    var lines = [];",
    "    lines.push('<span style=\"color:#888\">Frame  0: FULL (base frame)</span>');",
    "    for (var i = 0; i < counts.length; i++) {",
    "      var n = counts[i];",
    "      var sz = n <= threshold ? (1 + n * bytesPerCell) : 6912;",
    "      if (n <= threshold) {",
    "        lines.push('<span style=\"color:#4a9\">Frame ' + padNum(i + 1, 3) + ': DIFF  ' + padNum(n, 4) + ' cells (' + sz + ' bytes)</span>');",
    "      } else {",
    "        lines.push('<span style=\"color:#c55\">Frame ' + padNum(i + 1, 3) + ': FULL  ' + padNum(n, 4) + ' cells changed \\u2014 over threshold (' + sz + ' bytes)</span>');",
    "      }",
    "    }",
    "    detailList.innerHTML = lines.join('<br>');",
    "  }",
    "",
    "  updateStats();",
    "",
    "  // Live update on changes",
    "  unitGroup.addEventListener('change', updateStats);",
    "  threshInput.addEventListener('input', updateStats);",
    "",
    "  // --- Buttons ---",
    "  var btnRow = document.createElement('div');",
    "  btnRow.style.cssText = 'display: flex; gap: 8px; justify-content: flex-end;';",
    "",
    "  var cancelBtn = document.createElement('button');",
    "  cancelBtn.textContent = 'Cancel';",
    "  cancelBtn.style.cssText = 'padding: 4px 16px; font-size: 12px;';",
    "",
    "  var exportBtn = document.createElement('button');",
    "  exportBtn.textContent = 'Export';",
    "  exportBtn.style.cssText = 'padding: 4px 16px; font-size: 12px;';",
    "",
    "  btnRow.appendChild(cancelBtn);",
    "  btnRow.appendChild(exportBtn);",
    "  dialog.appendChild(btnRow);",
    "",
    "  overlay.appendChild(dialog);",
    "  document.body.appendChild(overlay);",
    "",
    "  function closeDialog() {",
    "    document.removeEventListener('keydown', onKey);",
    "    overlay.remove();",
    "  }",
    "",
    "  function onKey(e) {",
    "    if (e.key === 'Escape') { closeDialog(); e.preventDefault(); }",
    "  }",
    "",
    "  cancelBtn.addEventListener('click', closeDialog);",
    "  overlay.addEventListener('click', function(e) {",
    "    if (e.target === overlay) closeDialog();",
    "  });",
    "  document.addEventListener('keydown', onKey);",
    "",
    "  exportBtn.addEventListener('click', function() {",
    "    var unitRadio = overlay.querySelector('input[name=\"diffUnit\"]:checked');",
    "    var attrOnly = unitRadio && unitRadio.value === 'attronly';",
    "    var threshold = parseInt(threshInput.value, 10) || 48;",
    "    if (threshold < 1) threshold = 1;",
    "    if (threshold > 768) threshold = 768;",
    "",
    "    closeDialog();",
    "    doExport(frames, delays, threshold, attrOnly, fileName);",
    "  });",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Export — assemble ZIP and trigger download",
    "// -------------------------------------------------------------------",
    "function doExport(frames, delays, threshold, attrOnly, fileName) {",
    "  var result = generateAsm(frames, delays, threshold, attrOnly, fileName);",
    "  var asmText = result.asmText;",
    "  var binFiles = result.binFiles;",
    "",
    "  var zipFiles = [];",
    "",
    "  // Add ASM file",
    "  zipFiles.push({",
    "    name: 'animation_diff/animation.asm',",
    "    data: new TextEncoder().encode(asmText)",
    "  });",
    "",
    "  // Add binary frame files",
    "  for (var i = 0; i < binFiles.length; i++) {",
    "    zipFiles.push({",
    "      name: 'animation_diff/' + binFiles[i].name,",
    "      data: binFiles[i].data instanceof Uint8Array ? binFiles[i].data : new Uint8Array(binFiles[i].data)",
    "    });",
    "  }",
    "",
    "  var zip = createZip(zipFiles);",
    "  var baseName = fileName.replace(/\\.[^.]+$/, '').replace(/[^a-zA-Z0-9_-]/g, '_') || 'animation';",
    "  downloadFile(zip, baseName + '_diff.zip', 'application/zip');",
    "}",
    "",
    "// -------------------------------------------------------------------",
    "// Plugin API",
    "// -------------------------------------------------------------------",
    "plugin = {",
    "",
    "  extract: function(fileBytes) {",
    "    var parsed = parseScaType0(fileBytes);",
    "    if (!parsed) {",
    "      alert('This SCA file is not Type 0, or has fewer than 2 frames.\\nThe Diff Analyzer only supports Type 0 SCA animations with 2+ frames.');",
    "      return [];",
    "    }",
    "",
    "    // Store parsed data on window — plugin object is recreated each call,",
    "    // so closure variables don't survive between extract() and patch()",
    "    window._scaDiffAnalyzerData = {",
    "      frames: parsed.frames,",
    "      delays: parsed.delays",
    "    };",
    "",
    "    return [{ name: 'Frame 0', format: 'scr', data: parsed.frames[0] }];",
    "  },",
    "",
    "  patch: function(originalBytes, pictures) {",
    "    var stored = window._scaDiffAnalyzerData;",
    "    if (!stored || !stored.frames || stored.frames.length < 2) {",
    "      alert('No SCA animation data. Open a Type 0 .sca file with this plugin first.');",
    "      return null;",
    "    }",
    "",
    "    var name = (pictures.length > 0 && pictures[0].name) ? pictures[0].name : 'animation';",
    "    var cleanName = name.replace(/\\.[^.]+$/, '').replace(/_Frame_0$/i, '') || 'animation';",
    "",
    "    showDiffDialog(stored.frames, stored.delays, cleanName);",
    "    return null;",
    "  }",
    "",
    "};",
    ""
  ]
}
