{
  "_doc": [
    "Hero Quest 128K plugin for SpectraLab",
    "",
    "Extracts and patches graphics from Hero Quest 128K .sna snapshot.",
    "",
    "Graphics are stored in LINEAR format (not ZX-interleaved):",
    "  - Bitmap first (row-major, width*height bytes)",
    "  - Then linear attributes (cols*cellRows bytes)",
    "",
    "Since SpectraLab plugins work with standard SCR format,",
    "the plugin converts linear<->interleaved on extract/patch.",
    "The graphic is placed at the top-left of a full 256x192 SCR.",
    "Unused area is filled with a bright/regular white checkerboard",
    "to clearly mark the editable region.",
    "",
    "Port $7FFD bank values: $13=bank 3, $14=bank 4, $16=bank 6, $17=bank 7",
    "Bank offsets = Z80 address - 0xC000 (paging window)",
    "Each picture: 1152 bytes (1024 bitmap + 128 attrs, 0x480 spacing)",
    "Playfield is a full standard 6912-byte SCR (already ZX-interleaved)",
    "",
    "Bank 3 (port $13):",
    "  - 0x3382: Skeleton",
    "  - 0x3802: Lizardman",
    "Bank 4 (port $14):",
    "  - 0x2400: Mummy",
    "  - 0x2880: Orc",
    "  - 0x2D00: Defence",
    "  - 0x3180: Elf",
    "  - 0x3600: Dwarf",
    "  - 0x3A80: Wizard",
    "Bank 6 (port $16):",
    "  - 0x0000: Playfield (full SCR, 6912 bytes)",
    "Bank 7 (port $17):",
    "  - 0x0440: Hit",
    "  - 0x08C0: Knight"
  ],

  "id": "heroquest_128k",
  "name": "Hero Quest (128K .sna)",
  "version": 1,
  "description": "Extract/patch graphics from Hero Quest 128K snapshot — linear bitmap+attrs in banks 3/4/7, full SCR playfield in bank 6",
  "fileExtensions": [".sna"],
  "type": "js",
  "session": true,

  "jsSource": [
    "// =================================================================",
    "// Constants",
    "// =================================================================",
    "",
    "var SCR_COLS   = 32;",
    "var SCR_ROWS   = 24;",
    "var SCR_BITMAP = 6144;",
    "var SCR_TOTAL  = 6912;",
    "",
    "// Checkerboard attributes for unused area",
    "var ATTR_WHITE_BRIGHT  = 0x7F;  // ink=7 paper=7 bright=1",
    "var ATTR_WHITE_REGULAR = 0x3F;  // ink=7 paper=7 bright=0",
    "",
    "// Picture descriptors: { bank, offset, cols (bytes), cellRows, name }",
    "// Bank numbers are RAM bank index (port $7FFD bits 0-2)",
    "// Offsets are within the 16KB bank (Z80 addr - 0xC000)",
    "var PICTURES = [",
    "  // Bank 3 (port $13)",
    "  { bank: 3, offset: 0x3382, cols: 16, cellRows: 8, name: 'Skeleton' },",
    "  { bank: 3, offset: 0x3802, cols: 16, cellRows: 8, name: 'Lizardman' },",
    "  // Bank 4 (port $14)",
    "  { bank: 4, offset: 0x2400, cols: 16, cellRows: 8, name: 'Mummy' },",
    "  { bank: 4, offset: 0x2880, cols: 16, cellRows: 8, name: 'Orc' },",
    "  { bank: 4, offset: 0x2D00, cols: 16, cellRows: 8, name: 'Defence' },",
    "  { bank: 4, offset: 0x3180, cols: 16, cellRows: 8, name: 'Elf' },",
    "  { bank: 4, offset: 0x3600, cols: 16, cellRows: 8, name: 'Dwarf' },",
    "  { bank: 4, offset: 0x3A80, cols: 16, cellRows: 8, name: 'Wizard' },",
    "  // Bank 6 (port $16) — full standard SCR",
    "  { bank: 6, offset: 0x0000, cols: 32, cellRows: 24, name: 'Playfield', fullScr: true },",
    "  // Bank 7 (port $17)",
    "  { bank: 7, offset: 0x0440, cols: 16, cellRows: 8, name: 'Hit' },",
    "  { bank: 7, offset: 0x08C0, cols: 16, cellRows: 8, name: 'Knight' }",
    "];",
    "",
    "// =================================================================",
    "// Helpers",
    "// =================================================================",
    "",
    "// Pixel row y, byte col x -> SCR bitmap offset (ZX interleave)",
    "function scrOffset(y, x) {",
    "  return ((y & 0xC0) << 5) | ((y & 7) << 8) | ((y & 0x38) << 2) | x;",
    "}",
    "",
    "// Build a full SCR from linear graphic data",
    "function linearToScr(bank, desc) {",
    "  var cols     = desc.cols;",
    "  var cellRows = desc.cellRows;",
    "  var pxHeight = cellRows * 8;",
    "  var bitmapSz = cols * pxHeight;",
    "  var src      = desc.offset;",
    "",
    "  var scr = new Uint8Array(SCR_TOTAL);",
    "",
    "  // 1) Fill all attributes with bright/regular white checkerboard",
    "  for (var r = 0; r < SCR_ROWS; r++) {",
    "    for (var c = 0; c < SCR_COLS; c++) {",
    "      scr[SCR_BITMAP + r * SCR_COLS + c] =",
    "        ((r + c) & 1) ? ATTR_WHITE_BRIGHT : ATTR_WHITE_REGULAR;",
    "    }",
    "  }",
    "  // Bitmap for unused area stays 0 (ink=paper=white, invisible)",
    "",
    "  // 2) Copy linear bitmap -> interleaved SCR (top-left region)",
    "  for (var y = 0; y < pxHeight; y++) {",
    "    for (var x = 0; x < cols; x++) {",
    "      scr[scrOffset(y, x)] = bank[src + y * cols + x];",
    "    }",
    "  }",
    "",
    "  // 3) Copy linear attributes -> SCR attribute area",
    "  var attrSrc = src + bitmapSz;",
    "  for (var r = 0; r < cellRows; r++) {",
    "    for (var c = 0; c < cols; c++) {",
    "      scr[SCR_BITMAP + r * SCR_COLS + c] = bank[attrSrc + r * cols + c];",
    "    }",
    "  }",
    "",
    "  return scr;",
    "}",
    "",
    "// Extract top-left region from SCR back to linear format",
    "function scrToLinear(scr, bank, desc) {",
    "  var cols     = desc.cols;",
    "  var cellRows = desc.cellRows;",
    "  var pxHeight = cellRows * 8;",
    "  var bitmapSz = cols * pxHeight;",
    "  var dst      = desc.offset;",
    "",
    "  // 1) Interleaved SCR bitmap -> linear",
    "  for (var y = 0; y < pxHeight; y++) {",
    "    for (var x = 0; x < cols; x++) {",
    "      bank[dst + y * cols + x] = scr[scrOffset(y, x)];",
    "    }",
    "  }",
    "",
    "  // 2) SCR attributes -> linear",
    "  var attrDst = dst + bitmapSz;",
    "  for (var r = 0; r < cellRows; r++) {",
    "    for (var c = 0; c < cols; c++) {",
    "      bank[attrDst + r * cols + c] = scr[SCR_BITMAP + r * SCR_COLS + c];",
    "    }",
    "  }",
    "}",
    "",
    "// =================================================================",
    "// Plugin",
    "// =================================================================",
    "",
    "plugin = {",
    "",
    "  extract: function(fileBytes, snapshot) {",
    "    if (!snapshot || !snapshot.banks) {",
    "      throw new Error('128K .sna snapshot required');",
    "    }",
    "",
    "    var pics = [];",
    "    for (var i = 0; i < PICTURES.length; i++) {",
    "      var desc = PICTURES[i];",
    "      var bank = snapshot.banks[desc.bank];",
    "      if (!bank) {",
    "        throw new Error('Bank ' + desc.bank + ' not found in snapshot');",
    "      }",
    "      var scr;",
    "      if (desc.fullScr) {",
    "        scr = new Uint8Array(SCR_TOTAL);",
    "        scr.set(bank.subarray(desc.offset, desc.offset + SCR_TOTAL));",
    "      } else {",
    "        scr = linearToScr(bank, desc);",
    "      }",
    "      pics.push({",
    "        name:   desc.name + ' (bank ' + desc.bank +",
    "                ', 0x' + desc.offset.toString(16).toUpperCase() +",
    "                ', ' + (desc.cols * 8) + 'x' + (desc.cellRows * 8) + ')',",
    "        format: 'scr',",
    "        data:   scr",
    "      });",
    "    }",
    "",
    "    return pics;",
    "  },",
    "",
    "  patch: function(originalBytes, pictures, snapshot) {",
    "    if (!snapshot || !snapshot.banks) return originalBytes;",
    "",
    "    for (var i = 0; i < PICTURES.length; i++) {",
    "      if (i >= pictures.length) break;",
    "      if (pictures[i].data.length < SCR_TOTAL) continue;",
    "",
    "      var desc = PICTURES[i];",
    "      var bank = snapshot.banks[desc.bank];",
    "      if (!bank) continue;",
    "",
    "      if (desc.fullScr) {",
    "        bank.set(pictures[i].data.subarray(0, SCR_TOTAL), desc.offset);",
    "      } else {",
    "        scrToLinear(pictures[i].data, bank, desc);",
    "      }",
    "    }",
    "",
    "    return originalBytes;",
    "  }",
    "",
    "};"
  ]
}
